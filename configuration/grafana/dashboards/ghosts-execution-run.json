        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ghosts"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT timestamp AS \"Time\", eventtype AS \"Type\", description AS \"Description\", severity AS \"Severity\" FROM execution_events WHERE executionid = $execution ORDER BY timestamp DESC LIMIT 200"
        }
