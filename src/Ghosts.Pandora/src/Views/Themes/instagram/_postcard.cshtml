@model Ghosts.Pandora.Infrastructure.Models.Post
@{
    // A feed post. The NPC client likes through
    // //div[@class='post-actions']//child::div[@class='action-buttons']//child::button[@class='action-btn like-btn like-it'],
    // so those three class attributes must stay exactly as they are.
    var currentUser = ViewBag.Username as string;
    var currentUserLiked = !string.IsNullOrWhiteSpace(currentUser) &&
        (Model.Likes?.Any(l => string.Equals(l.Username, currentUser, StringComparison.OrdinalIgnoreCase)) ?? false);
    var likedClass = currentUserLiked ? " liked" : string.Empty;
    var score = Present.Score(Model);
    var comments = Present.CommentCount(Model);
    var caption = SocialPresentation.UploadedImage(Model) != null ? SocialPresentation.PlainText(Model) : Model.Message;
    var storyUsers = ViewData["IgStoryUsers"] as HashSet<string>;
    var hasStory = storyUsers?.Contains(Model.Username) == true;
    var located = Model.Id.ToByteArray()[3] % 3 == 0;
    var us = System.Globalization.CultureInfo.GetCultureInfo("en-US");
}
<article class="post" data-post-id="@Model.Id">
    <header class="post-header">
        <a href="/u/@Model.Username" class="ig-ring@(hasStory ? " has-story" : "")"><img src="/u/@Model.Username/avatar" alt="@Model.Username's profile picture" class="post-avatar"></a>
        <div class="post-meta">
            <div class="post-meta-line">
                <a href="/u/@Model.Username" class="post-user">@Model.Username</a>
                <span class="ig-sep">•</span>
                <a href="/posts/@Model.Id" class="post-ago"><time datetime="@Model.CreatedUtc.ToString("o")" title="@Model.CreatedUtc.ToString("MMM d, yyyy", us)">@SocialPresentation.ShortAgo(Model.CreatedUtc)</time></a>
            </div>
            @if (located)
            {
                <div class="post-location">@Present.World.City</div>
            }
        </div>
        <button type="button" class="ig-icon-btn ig-post-more" aria-label="More options" data-user="@Model.Username"><svg class="ig-i"><use href="#ig-dots"/></svg></button>
    </header>
    <div class="post-media" data-ig-dbl-like>
        <img src="@Present.PhotoUrl(Model)" alt="Photo by @Present.DisplayName(Model.Username)" loading="lazy">
        <span class="ig-burst" aria-hidden="true"><svg><use href="#ig-heart-fill"/></svg></span>
    </div>
    <div class="post-actions">
        <div class="action-buttons">
            <button class="action-btn like-btn like-it@(likedClass)" data-id="@Model.Id" aria-label="Like"></button>
            <a href="/posts/@Model.Id" class="ig-icon-btn" aria-label="Comment"><svg class="ig-i"><use href="#ig-comment"/></svg></a>
            <button type="button" class="ig-icon-btn ig-share" aria-label="Share Post"><svg class="ig-i"><use href="#ig-share"/></svg></button>
        </div>
        <button type="button" class="ig-icon-btn ig-save" aria-label="Save"><svg class="ig-i"><use href="#ig-save"/></svg></button>
    </div>
    <div class="post-likes"><span class="ig-like-count" data-base="@(score - (currentUserLiked ? 1 : 0))">@score.ToString("N0", us)</span> @(score == 1 ? "like" : "likes")</div>
    <div class="post-caption">
        <a href="/u/@Model.Username" class="post-user">@Model.Username</a>
        <span class="caption-text">@MessageHtml.Render(caption)</span>
    </div>
    @if (comments > 0)
    {
        <a href="/posts/@Model.Id" class="post-view-comments">@(comments == 1 ? "View 1 comment" : $"View all {comments} comments")</a>
    }
    <div class="ig-recent-comments"></div>
    <div class="add-comment">
        <input type="text" class="comment-input" placeholder="Add a comment…" aria-label="Add a comment…" autocomplete="off">
        <button type="button" class="comment-post-btn">Post</button>
        <svg class="ig-i ig-i-13 ig-emoji" aria-hidden="true"><use href="#ig-emoji"/></svg>
    </div>
</article>
