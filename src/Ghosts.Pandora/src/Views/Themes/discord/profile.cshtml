@model Ghosts.Pandora.Infrastructure.Models.User
@inject Ghosts.Pandora.Infrastructure.Services.IUserService Users
@{
    Layout = null;
    ViewBag.Theme = "discord";
    await Html.RenderPartialAsync("~/Views/Themes/discord/_discordhelpers.cshtml");
    var role = (Func<string, string>)Context.Items["dc.role"];
    var roleCss = (Func<string, string>)Context.Items["dc.rolecss"];
    var presence = (Func<string, string>)Context.Items["dc.presence"];
    var presenceLabel = (Func<string, string>)Context.Items["dc.presencelabel"];
    var activity = (Func<string, string>)Context.Items["dc.activity"];
    var since = (Func<string, int, int, DateTime>)Context.Items["dc.since"];
    var world = Present.World;
    var me = ViewBag.Username as string ?? "user";
    var username = Model?.Username ?? ViewBag.ProfileUsername as string ?? me;
    var isSelf = ViewBag.IsSelf as bool? ?? false;
    var isFriend = ViewBag.IsFollowing as bool? ?? false;
    var server = $"{world.ShortName} Staff";
    var status = presence(username);
    var custom = activity(username);
    var person = world.People.FirstOrDefault(p => string.Equals(p.Username, username, StringComparison.OrdinalIgnoreCase));
    // the seeded bio is a placeholder ("User fwright"), so only a real one is shown
    var bio = Model?.Bio is { Length: > 0 } b && b != $"User {username}" ? b : null;
    var hash = Ghosts.Pandora.Infrastructure.Content.ContentRequest.StableHash(username.ToLowerInvariant());
    string[] banners = { "#5865f2", "#1f8b4c", "#c27c0e", "#71368a", "#11806a", "#ad1457", "#206694", "#a84300" };
    var others = (await Users.GetUsersByThemeAsync("discord", 60))
        .Where(u => !string.Equals(u.Username, username, StringComparison.OrdinalIgnoreCase) && !string.Equals(u.Username, me, StringComparison.OrdinalIgnoreCase))
        .OrderBy(u => Ghosts.Pandora.Infrastructure.Content.ContentRequest.StableHash(username + u.Username))
        .Take(2 + (int)(hash % 5))
        .ToList();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Discord | @Present.DisplayName(username)</title>
    <link rel="stylesheet" href="/themes/discord/css/feed.css">
    <link rel="icon" href="/themes/discord/images/discord-icon.png">
    <meta name="current-user" content="@me">
</head>
<body data-theme="discord" data-me="@me" data-me-name="@Present.DisplayName(me)" data-server="@server">
    @await Html.PartialAsync("~/Views/Themes/discord/_discordicons.cshtml")
    <div class="dc-app">
        <header class="dc-titlebar">
            <div class="dc-titlebar-title"><span class="dc-titlebar-icon org">@world.ShortName[..1]</span>@server</div>
            <div class="dc-titlebar-actions">
                <button type="button" class="dc-icon-btn" data-tip="Inbox" data-inert><svg class="ic" width="20" height="20"><use href="#i-inbox"/></svg></button>
                <button type="button" class="dc-icon-btn" data-tip="Help" data-inert><svg class="ic" width="20" height="20"><use href="#i-help"/></svg></button>
            </div>
        </header>
        <div class="dc-base">
            @await Html.PartialAsync("~/Views/Themes/discord/_discordrail.cshtml", "staff")
            @await Html.PartialAsync("~/Views/Themes/discord/_discordchannels.cshtml", new List<Ghosts.Pandora.Infrastructure.Models.Post>())
            <main class="dc-chat">
                <div class="dc-chat-header">
                    <svg class="ic dc-chat-icon" width="24" height="24"><use href="#i-hash"/></svg>
                    <h1 class="dc-chat-title">general</h1>
                </div>
                <div class="dc-chat-body"></div>
            </main>
        </div>
        @await Html.PartialAsync("~/Views/Themes/discord/_discorduserpanel.cshtml")

        <a href="/" class="dc-modal-backdrop" aria-label="Close"></a>
        <section class="dc-profile" role="dialog" aria-label="User Profile" data-tabs-scope style="--banner: @banners[hash % (uint)banners.Length]">
            <div class="dc-profile-banner"></div>
            <a href="/" class="dc-icon-btn dc-profile-close" data-tip="Close"><svg class="ic" width="20" height="20"><use href="#i-close"/></svg></a>
            <div class="dc-profile-top">
                <span class="dc-avatar s120"><img src="/u/@username/avatar" alt=""><i class="dc-status @status" data-tip="@presenceLabel(status)"></i></span>
                <div class="dc-profile-actions">
                    @if (isSelf)
                    {
                        <button type="button" class="dc-btn" data-inert>Edit Profile</button>
                    }
                    else
                    {
                        <a href="/messages/conversation/@username" class="dc-btn primary"><svg class="ic" width="18" height="18"><use href="#i-chat"/></svg>Message</a>
                        <button type="button" class="dc-btn icon@(isFriend ? " pending" : "")" data-friend="@(isFriend ? "true" : "false")" data-username="@username" data-tip="@(isFriend ? "Remove Friend" : "Add Friend")">
                            <svg class="ic dc-friend-add" width="20" height="20"><use href="#i-user-add"/></svg>
                            <svg class="ic dc-friend-done" width="20" height="20"><use href="#i-user-check"/></svg>
                        </button>
                        <button type="button" class="dc-btn icon" data-popover="dc-profile-more" data-tip="More"><svg class="ic" width="20" height="20"><use href="#i-more"/></svg></button>
                        <div class="dc-popover dc-menu" id="dc-profile-more" hidden>
                            <button type="button" class="dc-menu-item" data-inert>Invite to Server</button>
                            <button type="button" class="dc-menu-item" data-inert>Ignore</button>
                            <button type="button" class="dc-menu-item danger" data-inert>Block</button>
                            <button type="button" class="dc-menu-item danger" data-inert>Report User Profile</button>
                            <div class="dc-menu-sep"></div>
                            <button type="button" class="dc-menu-item" data-copy="@username">Copy Username</button>
                        </div>
                    }
                </div>
            </div>

            <div class="dc-profile-body">
                <div class="dc-profile-names">
                    <h1 class="dc-profile-name">@Present.DisplayName(username)</h1>
                    <div class="dc-profile-handle">@username</div>
                    @if (custom != null)
                    {
                        <div class="dc-profile-bubble">@custom</div>
                    }
                </div>

                <div class="dc-tabs dc-profile-tabs">
                    <button type="button" class="dc-tab selected" data-tab="about">About Me</button>
                    <button type="button" class="dc-tab" data-tab="servers">Mutual Servers</button>
                    <button type="button" class="dc-tab" data-tab="friends">Mutual Friends</button>
                </div>

                <div class="dc-profile-panel" data-tab-panel="about">
                    <p class="dc-profile-about">@(bio ?? Present.Headline(username))</p>
                    @if (person != null)
                    {
                        <p class="dc-profile-about muted">@person.Department · @world.City</p>
                    }

                    <h2 class="dc-profile-label">Member Since</h2>
                    <div class="dc-profile-since">
                        <svg class="ic" width="16" height="16" data-tip="Discord"><use href="#i-clyde"/></svg>
                        <span>@since(username, 2016, 2024).ToString("MMM d, yyyy", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span>
                        <span class="dc-dot"></span>
                        <span class="dc-titlebar-icon org" data-tip="@server">@world.ShortName[..1]</span>
                        <span>@since(username + ":staff", 2023, 2026).ToString("MMM d, yyyy", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span>
                    </div>

                    @if (role(username) != null)
                    {
                        <h2 class="dc-profile-label">Roles</h2>
                        <div class="dc-roles">
                            <span class="dc-role @roleCss(username)"><i></i>@role(username)</span>
                            <span class="dc-role"><i></i>Staff</span>
                        </div>
                    }

                    <h2 class="dc-profile-label">Note <small>(only visible to you)</small></h2>
                    <textarea class="dc-profile-note" placeholder="Click to add a note" rows="2" maxlength="256"></textarea>
                </div>

                <div class="dc-profile-panel" data-tab-panel="servers" hidden>
                    <a href="/" class="dc-profile-row">
                        <span class="dc-guild-icon org">@world.ShortName[..1]</span>
                        <span class="dc-profile-row-text"><strong>@server</strong><small>@(person != null ? person.Title : "Member")</small></span>
                    </a>
                    @if (hash % 2 == 0)
                    {
                        <div class="dc-profile-row">
                            <span class="dc-guild-icon"><img src="/img/post4.jpg" alt=""></span>
                            <span class="dc-profile-row-text"><strong>@world.City Community</strong></span>
                        </div>
                    }
                </div>

                <div class="dc-profile-panel" data-tab-panel="friends" hidden>
                    @foreach (var friend in others)
                    {
                        <a href="/u/@friend.Username" class="dc-profile-row">
                            <span class="dc-avatar s40"><img src="/u/@friend.Username/avatar" alt=""><i class="dc-status @presence(friend.Username)"></i></span>
                            <span class="dc-profile-row-text"><strong>@Present.DisplayName(friend.Username)</strong><small>@friend.Username</small></span>
                        </a>
                    }
                </div>
            </div>
        </section>
    </div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/themes/discord/js/discord.js"></script>
</body>
</html>
