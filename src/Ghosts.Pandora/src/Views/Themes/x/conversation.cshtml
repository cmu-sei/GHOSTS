@inject Ghosts.Pandora.Infrastructure.Services.IUserService Users
@inject Ghosts.Pandora.Infrastructure.Services.IFollowService Follows
@{
    Layout = null;
    ViewBag.Theme = "x";
    ViewData["XNav"] = "messages";
    var me = ViewBag.Username as string ?? "user";
    string partner = ViewBag.PartnerUsername;
    ViewData["XChat"] = partner;
    var messages = ((IEnumerable<Ghosts.Pandora.Infrastructure.Models.DirectMessage>)ViewBag.Conversation ?? Enumerable.Empty<Ghosts.Pandora.Infrastructure.Models.DirectMessage>()).ToList();
    var partnerUser = await Users.GetUserByUsernameAsync(partner, "x");
    var followers = partnerUser == null ? 0 : await Follows.GetFollowerCountAsync(partnerUser.Id);
    var joined = (partnerUser?.CreatedUtc ?? DateTime.UtcNow).ToString("MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("en-US"));
    var bio = partnerUser == null || string.IsNullOrWhiteSpace(partnerUser.Bio) || partnerUser.Bio == $"User {partner}" ? Present.Headline(partner) : partnerUser.Bio;
    bool Mine(Ghosts.Pandora.Infrastructure.Models.DirectMessage m) => string.Equals(m.FromUsername, me, StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="current-user" content="@me">
    <title>@Present.DisplayName(partner) / X</title>
    <link rel="stylesheet" href="/themes/x/css/x.css?@System.Guid.NewGuid()">
    <link rel="icon" href="/themes/x/images/favicon.svg" type="image/svg+xml">
</head>
<body data-theme="x" class="x-chat-page">
    @await Html.PartialAsync("/Views/Themes/x/_xsprite.cshtml")
    <div class="x-app">
        @await Html.PartialAsync("/Views/Themes/x/_xnav.cshtml")
        <main class="x-main" role="main">
            <div class="x-main-inner">
                <div class="x-dm has-chat">
                    @await Html.PartialAsync("/Views/Themes/x/_xdmlist.cshtml")
                    <section class="x-dm-pane" aria-label="Conversation">
                        <div class="x-sticky x-chat-head">
                            <a href="/messages" class="x-back x-chat-back" aria-label="Back"><svg><use href="#x-back"/></svg></a>
                            <img src="/u/@partner/avatar" alt="">
                            <h2>@Present.DisplayName(partner)</h2>
                            <a href="/u/@partner" class="x-icon-btn" aria-label="Conversation info"><svg><use href="#x-info"/></svg></a>
                        </div>

                        <div class="x-chat-scroll">
                            <a href="/u/@partner" class="x-chat-person">
                                <img src="/u/@partner/avatar" alt="">
                                <span class="tweet-name">@Present.DisplayName(partner)</span>
                                <span class="x-profile-handle">@Present.Handle(partner)</span>
                                <p>@bio</p>
                                <small>Joined @joined · @followers.ToString("N0") @(followers == 1 ? "Follower" : "Followers")</small>
                            </a>

                            @for (var i = 0; i < messages.Count; i++)
                            {
                                var message = messages[i];
                                var next = i + 1 < messages.Count ? messages[i + 1] : null;
                                // a time goes under the last bubble of each run, as on X
                                var endOfRun = next == null || Mine(next) != Mine(message) || next.CreatedUtc - message.CreatedUtc > TimeSpan.FromMinutes(5);
                                <div class="x-msg@(Mine(message) ? " sent" : "")">
                                    <div class="x-bubble">@MessageHtml.Render(message.Message)</div>
                                    @if (endOfRun)
                                    {
                                        <div class="x-msg-time" title="@message.CreatedUtc.ToString("MMM d, yyyy, h:mm tt")">@message.CreatedUtc.ToString(message.CreatedUtc.Date == DateTime.UtcNow.Date ? "h:mm tt" : "MMM d, yyyy, h:mm tt")@(Mine(message) && message.ReadUtc != null ? " · Seen" : "")</div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="x-chat-compose">
                            <form method="post" action="/messages/send" class="x-chat-form" data-empty>
                                <input type="hidden" name="toUsername" value="@partner">
                                <button type="button" class="option-btn" aria-label="Add photos or video"><svg><use href="#x-media"/></svg></button>
                                <button type="button" class="option-btn" aria-label="Add a GIF"><svg><use href="#x-gif"/></svg></button>
                                <button type="button" class="option-btn" aria-label="Add emoji"><svg><use href="#x-emoji"/></svg></button>
                                <textarea name="message" placeholder="Start a new message" rows="1" required></textarea>
                                <button type="submit" class="x-icon-btn x-send" aria-label="Send"><svg><use href="#x-send"/></svg></button>
                            </form>
                        </div>
                    </section>
                </div>
            </div>
        </main>
    </div>

    <script src="/themes/x/js/x.js?@System.Guid.NewGuid()"></script>
</body>
</html>
