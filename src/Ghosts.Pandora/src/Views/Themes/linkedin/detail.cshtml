@using Ghosts.Pandora.Infrastructure.Content
@model Ghosts.Pandora.Infrastructure.Models.Post
@functions {
    static string LinkedInAgo(DateTime createdUtc)
    {
        var age = DateTime.UtcNow - DateTime.SpecifyKind(createdUtc, DateTimeKind.Utc);
        if (age < TimeSpan.FromMinutes(1)) return "now";
        if (age < TimeSpan.FromHours(1)) return $"{(int)age.TotalMinutes}m";
        if (age < TimeSpan.FromDays(1)) return $"{(int)age.TotalHours}h";
        if (age < TimeSpan.FromDays(7)) return $"{(int)age.TotalDays}d";
        if (age < TimeSpan.FromDays(30)) return $"{(int)(age.TotalDays / 7)}w";
        if (age < TimeSpan.FromDays(365)) return $"{(int)(age.TotalDays / 30)}mo";
        return $"{(int)(age.TotalDays / 365)}yr";
    }
}
@{
    Layout = null;
    ViewBag.Theme = "linkedin";
    ViewData["LiNav"] = "home";
    ViewData["LiDetail"] = true;
    var me = ViewBag.Username as string ?? string.Empty;
    var text = Model == null ? string.Empty : SocialPresentation.PlainText(Model);
    var title = Model == null
        ? "LinkedIn"
        : $"{Present.DisplayName(Model.Username)} on LinkedIn: {(text.Length > 70 ? text[..70].TrimEnd() + "…" : text)}";
    var comments = Model?.Comments?.OrderByDescending(c => c.CreatedUtc).ToList() ?? new List<Ghosts.Pandora.Infrastructure.Models.Comment>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="current-user" content="@me">
    <meta name="current-user-name" content="@Present.DisplayName(me)">
    <meta name="current-user-headline" content="@Present.Headline(me)">
    <title>@title</title>
    <link rel="stylesheet" href="/themes/linkedin/css/feed.css?@System.Guid.NewGuid()">
    <link rel="icon" href="/themes/linkedin/images/favicon.svg" type="image/svg+xml">
</head>
<body data-theme="linkedin" class="li-body">
    @await Html.PartialAsync("~/Views/Themes/linkedin/_header.cshtml")

    <div class="li-page li-page--feed">
        <aside class="li-left">
            @await Html.PartialAsync("~/Views/Themes/linkedin/_identity.cshtml")
        </aside>

        <main class="li-main">
            @if (Model == null)
            {
                <div class="li-card li-empty">
                    <h2>This post cannot be displayed</h2>
                    <p>It may have been removed, or you may not have access to it.</p>
                    <a href="/" class="li-btn li-btn--primary">Go to your feed</a>
                </div>
            }
            else
            {
                <div class="post-detail" data-post-id="@Model.Id">
                    @await Html.PartialAsync("_PostCard", Model)

                    <section class="li-comments" aria-label="Comments">
                        <div class="add-comment">
                            <img src="/u/@me/avatar" alt="" class="comment-avatar">
                            <div class="comment-input-container">
                                <input type="text" id="li-comment-input" placeholder="Add a comment…" class="comment-input" autocomplete="off" aria-label="Add a comment">
                                <span class="li-comment-tools">
                                    <button type="button" class="li-iconbtn" aria-label="Open Emoji Keyboard"><svg width="24" height="24"><use href="#li-emoji"/></svg></button>
                                    <button type="button" class="li-iconbtn" aria-label="Add a photo"><svg width="24" height="24"><use href="#li-image"/></svg></button>
                                </span>
                                <button type="button" class="comment-post-btn">Comment</button>
                            </div>
                        </div>

                        @if (comments.Count > 0)
                        {
                            <button type="button" class="li-sort__btn li-comments__sort li-inert">Most relevant <svg width="16" height="16"><use href="#li-caret"/></svg></button>
                        }

                        <div class="comments-list">
                            @foreach (var comment in comments)
                            {
                                var isAuthor = string.Equals(comment.Username, Model.Username, StringComparison.OrdinalIgnoreCase);
                                var isMe = string.Equals(comment.Username, me, StringComparison.OrdinalIgnoreCase);
                                var inWorld = Present.World.People.Any(p => string.Equals(p.Username, comment.Username, StringComparison.OrdinalIgnoreCase));
                                var degree = isMe ? "You" : ContentRequest.StableHash($"{me}:{comment.Username}:degree") % 100 < (inWorld ? 70u : 35u) ? "2nd" : "3rd+";
                                var likes = (int)(ContentRequest.StableHash($"{comment.Id}:likes") % 7);
                                <div class="comment">
                                    <a href="/u/@comment.Username"><img src="/u/@comment.Username/avatar" alt="" class="comment-avatar"></a>
                                    <div class="comment-content">
                                        <div class="comment-header">
                                            <span class="comment-author"><a href="/u/@comment.Username">@Present.DisplayName(comment.Username)</a><span class="comment-degree"> &bull; @degree</span>@if (isAuthor){<span class="comment-badge">Author</span>}</span>
                                            <span class="comment-title">@Present.Headline(comment.Username)</span>
                                            <span class="comment-time">@LinkedInAgo(comment.CreatedUtc)</span>
                                        </div>
                                        <div class="comment-text">@MessageHtml.Render(comment.Message)</div>
                                        <div class="comment-actions">
                                            <button type="button" class="comment-action like-action">Like</button>
                                            @if (likes > 0)
                                            {
                                                <span class="comment-likes"><svg width="16" height="16"><use href="#li-r-like"/></svg>@likes</span>
                                            }
                                            <span class="comment-sep">|</span>
                                            <button type="button" class="comment-action reply-action">Reply</button>
                                        </div>
                                    </div>
                                    <button type="button" class="comment-menu" aria-label="Open options"><svg width="16" height="16"><use href="#li-more"/></svg></button>
                                </div>
                            }
                            @if (comments.Count == 0)
                            {
                                <div class="no-comments">No comments, yet. <span>Be the first to comment.</span></div>
                            }
                        </div>
                    </section>
                </div>
            }
        </main>

        <aside class="li-right">
            @await Html.PartialAsync("~/Views/Themes/linkedin/_rail.cshtml", Model == null ? new List<Ghosts.Pandora.Infrastructure.Models.Post>() : new List<Ghosts.Pandora.Infrastructure.Models.Post> { Model })
        </aside>
    </div>

    @await Html.PartialAsync("_Scripts")
    <script src="/themes/linkedin/js/linkedin.js?@System.Guid.NewGuid()"></script>
</body>
</html>
