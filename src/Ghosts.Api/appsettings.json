            ],
            "GroupName": "{domain}-{host}",
            "GroupingDefinition": [
                {
                    "Value": "domain",
                    "Direction": "LeftToRight",
                    "Replacements": {
                        ".": "-",
                        "^": "-"
                    }
                },
                {
                    "Value": "host",
                    "Direction": "LeftToRight",
                    "Replacements": {
                        ".": "-",
                        "^": "-"
                    }
                }
            ]
        },
        "AnimatorSettings": {
            "Proxy": ""
        }
    },
