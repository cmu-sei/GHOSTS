@{
    Layout = null;
    ViewBag.Theme = "facebook";
    ViewBag.FbNewMessage = Context.Request.Query["new"].ToString() == "1";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Messenger | Facebook</title>
    <link rel="stylesheet" href="/themes/facebook/css/facebook.css">
    <link rel="icon" href="/themes/facebook/images/favicon.svg" type="image/svg+xml">
</head>
<body data-theme="facebook" class="fb-page-messenger">
    @await Html.PartialAsync("~/Views/Themes/facebook/_fbheader.cshtml")
    @await Html.PartialAsync("~/Views/Themes/facebook/_fbmessenger.cshtml")
    <script src="/themes/facebook/js/facebook.js"></script>
</body>
</html>
