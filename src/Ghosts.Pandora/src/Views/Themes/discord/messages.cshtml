@inject Ghosts.Pandora.Infrastructure.Services.IUserService Users
@{
    Layout = null;
    ViewBag.Theme = "discord";
    await Html.RenderPartialAsync("~/Views/Themes/discord/_discordhelpers.cshtml");
    var presence = (Func<string, string>)Context.Items["dc.presence"];
    var presenceLabel = (Func<string, string>)Context.Items["dc.presencelabel"];
    var activity = (Func<string, string>)Context.Items["dc.activity"];
    var me = ViewBag.Username as string ?? "user";
    var friends = (await Users.GetUsersByThemeAsync("discord", 60)).Select(u => u.Username)
        .Where(u => !string.Equals(u, me, StringComparison.OrdinalIgnoreCase))
        .OrderBy(u => Present.DisplayName(u), StringComparer.OrdinalIgnoreCase).ToList();
    var playing = friends.Where(u => activity(u)?.StartsWith("Playing ") == true || activity(u)?.StartsWith("Listening ") == true).Take(3).ToList();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Discord | Friends</title>
    <link rel="stylesheet" href="/themes/discord/css/feed.css">
    <link rel="icon" href="/themes/discord/images/discord-icon.png">
    <meta name="current-user" content="@me">
</head>
<body data-theme="discord" data-me="@me" data-me-name="@Present.DisplayName(me)">
    @await Html.PartialAsync("~/Views/Themes/discord/_discordicons.cshtml")
    <div class="dc-app">
        <header class="dc-titlebar">
            <div class="dc-titlebar-title"><svg class="ic" width="20" height="20"><use href="#i-friends"/></svg>Friends</div>
            <div class="dc-titlebar-actions">
                <button type="button" class="dc-icon-btn" data-tip="Inbox" data-inert><svg class="ic" width="20" height="20"><use href="#i-inbox"/></svg></button>
                <button type="button" class="dc-icon-btn" data-tip="Help" data-inert><svg class="ic" width="20" height="20"><use href="#i-help"/></svg></button>
            </div>
        </header>
        <div class="dc-base">
            @await Html.PartialAsync("~/Views/Themes/discord/_discordrail.cshtml", "home")
            @await Html.PartialAsync("~/Views/Themes/discord/_discorddms.cshtml", (string)null)

            <main class="dc-chat dc-friends-page" data-tabs-scope>
                <div class="dc-chat-header">
                    <button type="button" class="dc-icon-btn dc-mobile-only" data-drawer="nav" data-tip="Direct Messages"><svg class="ic" width="22" height="22"><use href="#i-menu"/></svg></button>
                    <svg class="ic dc-chat-icon" width="24" height="24"><use href="#i-friends"/></svg>
                    <h1 class="dc-chat-title">Friends</h1>
                    <span class="dc-dot dc-desktop-only"></span>
                    <div class="dc-tabs dc-friends-tabs">
                        <button type="button" class="dc-tab selected" data-tab="online">Online</button>
                        <button type="button" class="dc-tab" data-tab="all">All</button>
                        <button type="button" class="dc-tab dc-desktop-only" data-tab="pending">Pending</button>
                        <button type="button" class="dc-tab dc-tab-add" data-tab="add">Add Friend</button>
                    </div>
                    <div class="dc-chat-tools">
                        <button type="button" class="dc-icon-btn" data-popover="dc-new-dm" data-tip="New Group DM"><svg class="ic" width="22" height="22"><use href="#i-chat-plus"/></svg></button>
                    </div>
                </div>
                <div class="dc-chat-body">
                    <section class="dc-friends-main">
                        <div data-tab-panel="online all">
                            <label class="dc-friends-search">
                                <input type="text" placeholder="Search" aria-label="Search friends">
                                <svg class="ic" width="18" height="18"><use href="#i-search"/></svg>
                            </label>
                            <h2 class="dc-members-head dc-friends-count">Online — 0</h2>
                            <div class="dc-friends">
                                @foreach (var friend in friends)
                                {
                                    var p = presence(friend);
                                    <a href="/messages/conversation/@friend" class="dc-friend" data-presence="@p">
                                        <span class="dc-avatar s32"><img src="/u/@friend/avatar" alt=""><i class="dc-status @p"></i></span>
                                        <span class="dc-friend-text">
                                            <span class="dc-friend-name">@Present.DisplayName(friend)<span class="dc-friend-handle">@friend</span></span>
                                            <span class="dc-friend-sub">@(activity(friend) ?? presenceLabel(p))</span>
                                        </span>
                                        <span class="dc-friend-actions">
                                            <span class="dc-round-btn" data-tip="Message"><svg class="ic" width="20" height="20"><use href="#i-chat"/></svg></span>
                                            <span class="dc-round-btn" data-tip="More" data-inert><svg class="ic" width="20" height="20"><use href="#i-more"/></svg></span>
                                        </span>
                                    </a>
                                }
                            </div>
                        </div>
                        <div data-tab-panel="pending" hidden>
                            <div class="dc-empty dc-friends-empty"><strong>There are no pending friend requests.</strong><span>Friend requests you send or receive show up here.</span></div>
                        </div>
                        <div data-tab-panel="add" hidden>
                            <form class="dc-add-friend-form">
                                <h2>Add Friend</h2>
                                <p>You can add friends with their Discord username.</p>
                                <div class="dc-add-friend-box">
                                    <input type="text" placeholder="You can add friends with their Discord username." aria-label="Username" autocomplete="off">
                                    <button type="submit" class="dc-btn primary" disabled>Send Friend Request</button>
                                </div>
                                <div class="dc-add-friend-note" hidden></div>
                            </form>
                        </div>
                    </section>
                    <aside class="dc-active-now">
                        <h2>Active Now</h2>
                        @if (playing.Count == 0)
                        {
                            <div class="dc-active-quiet"><strong>It's quiet for now...</strong><span>When a friend starts an activity, like playing a game or hanging out on voice, we'll show it here!</span></div>
                        }
                        @foreach (var friend in playing)
                        {
                            <a href="/u/@friend" class="dc-active-card">
                                <span class="dc-avatar s40"><img src="/u/@friend/avatar" alt=""><i class="dc-status @presence(friend)"></i></span>
                                <span class="dc-active-text">
                                    <strong>@Present.DisplayName(friend)</strong>
                                    <span>@activity(friend) — @(1 + Ghosts.Pandora.Infrastructure.Content.ContentRequest.StableHash(friend) % 5)h</span>
                                </span>
                            </a>
                        }
                    </aside>
                </div>
            </main>
        </div>
        @await Html.PartialAsync("~/Views/Themes/discord/_discorduserpanel.cshtml")
        <div class="dc-scrim" data-drawer-close></div>
    </div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/themes/discord/js/discord.js"></script>
</body>
</html>
