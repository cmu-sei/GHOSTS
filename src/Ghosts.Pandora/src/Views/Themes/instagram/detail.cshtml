@model Ghosts.Pandora.Infrastructure.Models.Post
@inject Ghosts.Pandora.Infrastructure.Services.IPostService Posts
@inject Ghosts.Pandora.Infrastructure.Services.IUserService Users
@inject Ghosts.Pandora.Infrastructure.Services.IFollowService Follows
@{
    Layout = null;
    ViewBag.Theme = "instagram";
    ViewData["IgMobileTitle"] = "Post";
    var currentUser = ViewBag.Username as string ?? string.Empty;
    var us = System.Globalization.CultureInfo.GetCultureInfo("en-US");

    var currentUserLiked = Model != null && !string.IsNullOrWhiteSpace(currentUser) &&
        (Model.Likes?.Any(l => string.Equals(l.Username, currentUser, StringComparison.OrdinalIgnoreCase)) ?? false);
    var likedClass = currentUserLiked ? " liked" : string.Empty;
    var score = Model == null ? 0 : Present.Score(Model);
    var caption = Model == null ? string.Empty : SocialPresentation.UploadedImage(Model) != null ? SocialPresentation.PlainText(Model) : Model.Message;
    var comments = Model?.Comments?.OrderByDescending(c => c.CreatedUtc).ToList() ?? new List<Comment>();
    var isMine = Model != null && string.Equals(Model.Username, currentUser, StringComparison.OrdinalIgnoreCase);

    var isFollowing = false;
    var morePosts = new List<Post>();
    if (Model != null)
    {
        var meUser = await Users.GetUserByUsernameAsync(currentUser, "instagram");
        if (meUser != null && !isMine && Model.UserId != Guid.Empty)
            isFollowing = await Follows.IsFollowingAsync(meUser.Id, Model.UserId);
        morePosts = (await Posts.GetPostsByUserAndTheme(Model.Username, "instagram", 7)).Where(p => p.Id != Model.Id).Take(6).ToList();
    }

    string When(DateTime utc)
    {
        var age = DateTime.UtcNow - DateTime.SpecifyKind(utc, DateTimeKind.Utc);
        if (age < TimeSpan.FromDays(7)) return SocialPresentation.LongAgo(utc);
        return utc.ToString(utc.Year == DateTime.UtcNow.Year ? "MMMM d" : "MMMM d, yyyy", us);
    }
    var title = Model == null ? "Page not found • Instagram" : $"{Present.DisplayName(Model.Username)} on Instagram: \"{SocialPresentation.PlainText(Model)}\"";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="current-user" content="@currentUser">
    <title>@title</title>
    <link rel="stylesheet" href="/themes/instagram/css/feed.css?@System.Guid.NewGuid()">
    <link rel="icon" href="/themes/instagram/images/favicon.svg" type="image/svg+xml">
</head>
<body data-theme="instagram" class="ig ig-post-view">
@await Html.PartialAsync("~/Views/Themes/instagram/_igsprite.cshtml")
@await Html.PartialAsync("~/Views/Themes/instagram/_ignav.cshtml")

<main class="ig-main">
    @if (Model == null)
    {
        <div class="ig-empty">
            <div class="ig-empty-title" style="font-size:24px;font-weight:600">Sorry, this page isn't available.</div>
            <div class="ig-empty-text">The link you followed may be broken, or the page may have been removed. <a href="/" class="ig-link-blue" style="font-size:14px">Go back to Instagram.</a></div>
        </div>
    }
    else
    {
        <div class="ig-post-page">
            <article class="ig-post-box post-detail" data-post-id="@Model.Id">
                <div class="ig-post-media" data-ig-dbl-like>
                    <img src="@Present.PhotoUrl(Model)" alt="Photo by @Present.DisplayName(Model.Username)">
                    <span class="ig-burst" aria-hidden="true"><svg><use href="#ig-heart-fill"/></svg></span>
                </div>
                <div class="ig-post-side">
                    <header class="ig-post-head">
                        <a href="/u/@Model.Username" class="ig-ring has-story"><img src="/u/@Model.Username/avatar" alt="@Model.Username's profile picture" class="post-avatar"></a>
                        <div class="post-meta">
                            <div class="post-meta-line">
                                <a href="/u/@Model.Username" class="post-user">@Model.Username</a>
                                @if (!isMine)
                                {
                                    <span class="ig-sep">•</span>
                                    <button type="button" class="ig-follow-inline@(isFollowing ? " is-following" : "")" data-username="@Model.Username">@(isFollowing ? "Following" : "Follow")</button>
                                }
                            </div>
                        </div>
                        <button type="button" class="ig-icon-btn ig-post-more" aria-label="More options" data-user="@Model.Username"><svg class="ig-i"><use href="#ig-dots"/></svg></button>
                    </header>

                    <div class="ig-post-comments">
                        <div class="ig-caption-comment">
                            <a href="/u/@Model.Username"><img src="/u/@Model.Username/avatar" alt="" class="comment-avatar"></a>
                            <div class="comment-content">
                                <div class="comment-text">
                                    <a href="/u/@Model.Username" class="comment-username">@Model.Username</a>
                                    <span class="caption-text">@MessageHtml.Render(caption)</span>
                                </div>
                                <div class="comment-actions"><time class="comment-time" datetime="@Model.CreatedUtc.ToString("o")">@SocialPresentation.ShortAgo(Model.CreatedUtc)</time></div>
                            </div>
                        </div>

                        <div class="comments-list">
                            @if (comments.Count == 0)
                            {
                                <div class="no-comments">
                                    <p>No comments yet.</p>
                                    <p>Start the conversation.</p>
                                </div>
                            }
                            @foreach (var comment in comments)
                            {
                                <div class="comment">
                                    <a href="/u/@comment.Username"><img src="/u/@comment.Username/avatar" alt="@comment.Username" class="comment-avatar"></a>
                                    <div class="comment-content">
                                        <div class="comment-text">
                                            <a href="/u/@comment.Username" class="comment-username">@comment.Username</a>
                                            <span class="comment-message">@MessageHtml.Render(comment.Message)</span>
                                        </div>
                                        <div class="comment-actions">
                                            <span class="comment-time">@SocialPresentation.ShortAgo(comment.CreatedUtc)</span>
                                            <button type="button" class="comment-like">Like</button>
                                            <button type="button" class="comment-reply">Reply</button>
                                        </div>
                                    </div>
                                    <button type="button" class="comment-like-btn" aria-label="Like"></button>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="ig-post-foot">
                        <div class="post-actions">
                            <div class="action-buttons">
                                <button class="action-btn like-btn like-it@(likedClass)" data-id="@Model.Id" aria-label="Like"></button>
                                <a href="#" class="ig-icon-btn" aria-label="Comment" data-ig-focus-comment><svg class="ig-i"><use href="#ig-comment"/></svg></a>
                                <button type="button" class="ig-icon-btn ig-share" aria-label="Share Post"><svg class="ig-i"><use href="#ig-share"/></svg></button>
                            </div>
                            <button type="button" class="ig-icon-btn ig-save" aria-label="Save"><svg class="ig-i"><use href="#ig-save"/></svg></button>
                        </div>
                        <div class="post-likes"><span class="ig-like-count" data-base="@(score - (currentUserLiked ? 1 : 0))">@score.ToString("N0", us)</span> @(score == 1 ? "like" : "likes")</div>
                        <time class="ig-post-date" datetime="@Model.CreatedUtc.ToString("o")" title="@Model.CreatedUtc.ToString("MMM d, yyyy", us)">@When(Model.CreatedUtc)</time>
                        <div class="add-comment" data-post-id="@Model.Id">
                            <input type="text" placeholder="Add a comment…" class="comment-input" aria-label="Add a comment…" autocomplete="off">
                            <button type="button" class="comment-post-btn">Post</button>
                            <svg class="ig-i ig-emoji" aria-hidden="true"><use href="#ig-emoji"/></svg>
                        </div>
                    </div>
                </div>
            </article>

            @if (morePosts.Count > 0)
            {
                <section class="ig-more-from">
                    <h2>More posts from <a href="/u/@Model.Username">@Model.Username</a></h2>
                    <div class="ig-grid">
                        @foreach (var p in morePosts)
                        {
                            <a href="/posts/@p.Id" class="ig-tile">
                                <img src="@Present.PhotoUrl(p)" alt="" loading="lazy">
                                <span class="ig-tile-overlay">
                                    <span><svg class="ig-i"><use href="#ig-heart-fill"/></svg>@SocialPresentation.Compact(Present.Score(p))</span>
                                    <span><svg class="ig-i" style="transform:scaleX(-1)"><use href="#ig-comment"/></svg>@Present.CommentCount(p)</span>
                                </span>
                            </a>
                        }
                    </div>
                </section>
            }
        </div>
    }
    <footer class="ig-profile-footer">
        <nav><a href="#" data-ig-inert>Meta</a><a href="#" data-ig-inert>About</a><a href="#" data-ig-inert>Blog</a><a href="#" data-ig-inert>Jobs</a><a href="#" data-ig-inert>Help</a><a href="#" data-ig-inert>API</a><a href="#" data-ig-inert>Privacy</a><a href="#" data-ig-inert>Terms</a><a href="#" data-ig-inert>Locations</a><a href="#" data-ig-inert>Instagram Lite</a><a href="#" data-ig-inert>Threads</a><a href="#" data-ig-inert>Meta Verified</a></nav>
        <div>English &nbsp; © @DateTime.UtcNow.Year Instagram from Meta</div>
    </footer>
</main>

@await Html.PartialAsync("_Scripts")
<script src="/themes/instagram/js/instagram.js?@System.Guid.NewGuid()"></script>
</body>
</html>
