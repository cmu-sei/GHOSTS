@inject Ghosts.Pandora.Infrastructure.Services.IUserService Users
@{
    Layout = null;
    ViewBag.Theme = "youtube";
    ViewData["ytActive"] = string.Empty;
    var me = ViewBag.Username as string ?? string.Empty;
    var partners = ViewBag.ConversationPartners as string[] ?? Array.Empty<string>();
    var people = (await Users.GetUsersByThemeAsync("youtube", 12))
        .Where(u => !string.Equals(u.Username, me, StringComparison.OrdinalIgnoreCase))
        .ToList();
    var suggested = people.Where(u => !partners.Contains(u.Username, StringComparer.OrdinalIgnoreCase)).Take(5).ToList();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="current-user" content="@me">
    <title>Messages - YouTube</title>
    <link rel="stylesheet" href="/themes/youtube/css/feed.css?@System.Guid.NewGuid()">
    <link rel="icon" href="/themes/youtube/images/youtube-icon.svg" type="image/svg+xml">
</head>
<body data-theme="youtube" class="yt-browse-page">
    @await Html.PartialAsync("~/Views/Themes/youtube/_masthead.cshtml")
    @await Html.PartialAsync("~/Views/Themes/youtube/_guide.cshtml")

    <main class="yt-page-manager">
        <div class="yt-inbox">
            @await Html.PartialAsync("~/Views/Themes/youtube/_inboxlist.cshtml")

            <div class="yt-inbox-main">
                <form class="yt-compose" method="post" action="/messages/send">
                    <h2>New message</h2>
                    <p>Send a private message to a channel. Only the two of you can see it.</p>
                    <div class="yt-field">
                        <label for="yt-dm-to">To</label>
                        <input id="yt-dm-to" type="text" name="toUsername" placeholder="Channel name or @@handle" list="yt-dm-people" autocomplete="off" required>
                        <datalist id="yt-dm-people">
                            @foreach (var person in people)
                            {
                                <option value="@person.Username">@Present.DisplayName(person.Username)</option>
                            }
                        </datalist>
                    </div>
                    @if (suggested.Count > 0)
                    {
                        <div class="yt-compose-people">
                            @foreach (var person in suggested)
                            {
                                <button class="yt-compose-person" type="button" data-username="@person.Username"><img src="/u/@person.Username/avatar" alt="">@Present.DisplayName(person.Username)</button>
                            }
                        </div>
                    }
                    <div class="yt-field yt-field-tall">
                        <label for="yt-dm-message">Message</label>
                        <textarea id="yt-dm-message" name="message" rows="5" maxlength="2000" placeholder="Write a message" required></textarea>
                    </div>
                    <div class="yt-compose-actions">
                        <button class="yt-pill yt-pill-blue" type="submit">Send</button>
                    </div>
                </form>
            </div>
        </div>
    </main>

    @await Html.PartialAsync("_Scripts")
    <script src="/themes/youtube/js/youtube.js?@System.Guid.NewGuid()"></script>
</body>
</html>
