@* Facebook top bar and the SVG icons every Facebook page uses. Set ViewBag.FbTab to "home" to mark the Home tab. *@
@inject Ghosts.Pandora.Infrastructure.Services.IUserService Users
@inject Ghosts.Pandora.Infrastructure.Services.IPostService Posts
@inject Ghosts.Pandora.Infrastructure.Services.IDirectMessageService Dms
@{
    var me = ViewBag.Username as string ?? string.Empty;
    var myName = Present.DisplayName(me);
    var tab = ViewBag.FbTab as string ?? string.Empty;
    var query = Context.Request.Query["q"].ToString();

    var unread = 0;
    var meUser = await Users.GetUserByUsernameAsync(me, "facebook");
    if (meUser != null)
    {
        unread = (await Dms.GetUnreadMessagesAsync(meUser.Id)).Count();
    }

    // notifications: what other people did on my posts
    var myPosts = string.IsNullOrEmpty(me) ? new List<Post>() : await Posts.GetPostsByUserAndTheme(me, "facebook", 25);
    var notes = myPosts
        .SelectMany(p => (p.Comments ?? new List<Comment>())
            .Where(c => !string.Equals(c.Username, me, StringComparison.OrdinalIgnoreCase))
            .Select(c => (Who: c.Username, What: "commented on your post", Text: SocialPresentation.PlainText(new Post { Message = c.Message }), Post: p.Id, When: c.CreatedUtc, Comment: true))
            .Concat((p.Likes ?? new List<Like>())
                .Where(l => !string.Equals(l.Username, me, StringComparison.OrdinalIgnoreCase))
                .Select(l => (Who: l.Username, What: "reacted to your post", Text: SocialPresentation.PlainText(p), Post: p.Id, When: l.CreatedUtc, Comment: false))))
        .OrderByDescending(n => n.When)
        .Take(8)
        .ToList();
    var newNotes = notes.Count(n => n.When > DateTime.UtcNow.AddDays(-1));

    var names = Present.World.People
        .Where(p => !string.IsNullOrEmpty(p.Username))
        .GroupBy(p => p.Username.ToLowerInvariant())
        .ToDictionary(g => g.Key, g => g.First().FullName);
}
