@{
    Layout = null;
    ViewBag.Theme = "instagram";
    ViewData["IgActive"] = "messages";
    var me = ViewBag.Username as string ?? string.Empty;
    string partner = ViewBag.PartnerUsername;
    ViewData["IgPartner"] = partner;
    var messages = ((IEnumerable<DirectMessage>)ViewBag.Conversation ?? Enumerable.Empty<DirectMessage>()).OrderBy(m => m.CreatedUtc).ToList();
    var us = System.Globalization.CultureInfo.GetCultureInfo("en-US");

    string Stamp(DateTime utc)
    {
        var now = DateTime.UtcNow;
        if (utc.Date == now.Date) return utc.ToString("h:mm tt", us);
        if (now - utc < TimeSpan.FromDays(7)) return utc.ToString("ddd h:mm tt", us);
        return utc.ToString(utc.Year == now.Year ? "MMM d, h:mm tt" : "MMM d, yyyy, h:mm tt", us);
    }
    bool IsMine(DirectMessage m) => string.Equals(m.FromUsername, me, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="current-user" content="@me">
    <title>@Present.DisplayName(partner) (@@@partner) • Direct</title>
    <link rel="stylesheet" href="/themes/instagram/css/feed.css?@System.Guid.NewGuid()">
    <link rel="icon" href="/themes/instagram/images/favicon.svg" type="image/svg+xml">
</head>
<body data-theme="instagram" class="ig ig-direct ig-compact-nav ig-in-thread">
@await Html.PartialAsync("~/Views/Themes/instagram/_igsprite.cshtml")
@await Html.PartialAsync("~/Views/Themes/instagram/_ignav.cshtml")

<main class="ig-main">
    <div class="ig-dm">
        @await Html.PartialAsync("~/Views/Themes/instagram/_iginbox.cshtml")
        <section class="ig-dm-main">
            <header class="ig-thread-head">
                <a href="/messages" class="ig-icon-btn ig-thread-back" aria-label="Back"><svg class="ig-i"><use href="#ig-back"/></svg></a>
                <a href="/u/@partner"><img src="/u/@partner/avatar" alt="@partner"></a>
                <a href="/u/@partner" class="ig-thread-title">
                    <b>@Present.DisplayName(partner)</b>
                    <span>@partner</span>
                </a>
                <div class="ig-thread-tools">
                    <a href="#" aria-label="Audio call" data-ig-inert><svg class="ig-i"><use href="#ig-phone"/></svg></a>
                    <a href="#" aria-label="Video call" data-ig-inert><svg class="ig-i"><use href="#ig-video"/></svg></a>
                    <a href="#" aria-label="Conversation information" data-ig-inert><svg class="ig-i"><use href="#ig-info"/></svg></a>
                </div>
            </header>

            <div class="chat-messages">
                <div class="ig-thread-intro">
                    <img src="/u/@partner/avatar" alt="">
                    <b>@Present.DisplayName(partner)</b>
                    <div class="ig-muted">@partner · Instagram</div>
                    <a href="/u/@partner" class="ig-btn">View profile</a>
                </div>
                @for (var i = 0; i < messages.Count; i++)
                {
                    var m = messages[i];
                    var prev = i > 0 ? messages[i - 1] : null;
                    var next = i + 1 < messages.Count ? messages[i + 1] : null;
                    var stamp = prev == null || m.CreatedUtc - prev.CreatedUtc > TimeSpan.FromHours(1);
                    var first = stamp || IsMine(prev) != IsMine(m);
                    var last = next == null || IsMine(next) != IsMine(m) || next.CreatedUtc - m.CreatedUtc > TimeSpan.FromHours(1);
                    if (stamp)
                    {
                        <div class="ig-stamp">@Stamp(m.CreatedUtc)</div>
                    }
                    <div class="chat-message @(IsMine(m) ? "sent" : "received")@(first ? " is-first" : "")@(last ? " is-last" : "")" title="@Stamp(m.CreatedUtc)">
                        <img src="/u/@(IsMine(m) ? me : partner)/avatar" alt="" class="chat-message-avatar">
                        <div class="chat-message-bubble">@MessageHtml.Render(m.Message)</div>
                    </div>
                    if (next == null && IsMine(m) && m.ReadUtc != null)
                    {
                        <div class="ig-seen">Seen</div>
                    }
                }
            </div>

            <div class="chat-input-container">
                <form method="post" action="/messages/send" class="chat-input-form">
                    <input type="hidden" name="toUsername" value="@partner">
                    <svg class="ig-i" aria-hidden="true"><use href="#ig-emoji"/></svg>
                    <textarea name="message" class="chat-input" placeholder="Message..." required rows="1" aria-label="Message"></textarea>
                    <span class="ig-chat-tools">
                        <svg class="ig-i" aria-label="Voice clip"><use href="#ig-mic"/></svg>
                        <svg class="ig-i" aria-label="Add photo or video"><use href="#ig-image"/></svg>
                        <svg class="ig-i ig-chat-heart" aria-label="Like" role="button"><use href="#ig-heart"/></svg>
                    </span>
                    <button type="submit" class="chat-send-btn">Send</button>
                </form>
            </div>
        </section>
    </div>
</main>

<script src="/themes/instagram/js/instagram.js?@System.Guid.NewGuid()"></script>
</body>
</html>
