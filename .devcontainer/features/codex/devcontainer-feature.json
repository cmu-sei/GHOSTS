{
    "id": "codex",
    "version": "0.1.0",
    "name": "Codex CLI",
    "description": "Installs the OpenAI Codex CLI via the official installer script",
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ],
    "postCreateCommand": "bash -l .devcontainer/features/codex/postcreate.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "openai.chatgpt"
            ]
        }
    }
}
