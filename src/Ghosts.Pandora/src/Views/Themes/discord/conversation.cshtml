@{
    Layout = null;
    ViewBag.Theme = "discord";
    await Html.RenderPartialAsync("~/Views/Themes/discord/_discordhelpers.cshtml");
    var roleCss = (Func<string, string>)Context.Items["dc.rolecss"];
    var presence = (Func<string, string>)Context.Items["dc.presence"];
    var presenceLabel = (Func<string, string>)Context.Items["dc.presencelabel"];
    var activity = (Func<string, string>)Context.Items["dc.activity"];
    var stamp = (Func<DateTime, string>)Context.Items["dc.stamp"];
    var time = (Func<DateTime, string>)Context.Items["dc.time"];
    var day = (Func<DateTime, string>)Context.Items["dc.day"];
    var iso = (Func<DateTime, string>)Context.Items["dc.iso"];
    var since = (Func<string, int, int, DateTime>)Context.Items["dc.since"];
    var us = System.Globalization.CultureInfo.GetCultureInfo("en-US");
    var world = Present.World;
    var me = ViewBag.Username as string ?? "user";
    var partner = ViewBag.PartnerUsername as string ?? "user";
    var partnerName = Present.DisplayName(partner);
    var status = presence(partner);
    var hash = Ghosts.Pandora.Infrastructure.Content.ContentRequest.StableHash(partner.ToLowerInvariant());
    string[] banners = { "#5865f2", "#1f8b4c", "#c27c0e", "#71368a", "#11806a", "#ad1457", "#206694", "#a84300" };

    // grouped the way a channel groups messages, newest first for the column-reverse list
    var messages = ((IEnumerable<Ghosts.Pandora.Infrastructure.Models.DirectMessage>)ViewBag.Conversation ?? Enumerable.Empty<Ghosts.Pandora.Infrastructure.Models.DirectMessage>())
        .OrderBy(m => m.CreatedUtc).ToList();
    var rows = new List<(Ghosts.Pandora.Infrastructure.Models.DirectMessage Message, bool Grouped, bool NewDay)>();
    for (var i = 0; i < messages.Count; i++)
    {
        var m = messages[i];
        var prev = i > 0 ? messages[i - 1] : null;
        var newDay = prev == null || prev.CreatedUtc.Date != m.CreatedUtc.Date;
        rows.Add((m, !newDay && prev.FromUsername == m.FromUsername && m.CreatedUtc - prev.CreatedUtc < TimeSpan.FromMinutes(7), newDay));
    }
    rows.Reverse();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Discord | @@@partnerName</title>
    <link rel="stylesheet" href="/themes/discord/css/feed.css">
    <link rel="icon" href="/themes/discord/images/discord-icon.png">
    <meta name="current-user" content="@me">
</head>
<body data-theme="discord" data-me="@me" data-me-name="@Present.DisplayName(me)">
    @await Html.PartialAsync("~/Views/Themes/discord/_discordicons.cshtml")
    <div class="dc-app">
        <header class="dc-titlebar">
            <div class="dc-titlebar-title"><span class="dc-titlebar-icon"><img src="/u/@partner/avatar" alt=""></span>@partnerName</div>
            <div class="dc-titlebar-actions">
                <button type="button" class="dc-icon-btn" data-tip="Inbox" data-inert><svg class="ic" width="20" height="20"><use href="#i-inbox"/></svg></button>
                <button type="button" class="dc-icon-btn" data-tip="Help" data-inert><svg class="ic" width="20" height="20"><use href="#i-help"/></svg></button>
            </div>
        </header>
        <div class="dc-base">
            @await Html.PartialAsync("~/Views/Themes/discord/_discordrail.cshtml", "home")
            @await Html.PartialAsync("~/Views/Themes/discord/_discorddms.cshtml", partner)

            <main class="dc-chat dc-dm-chat">
                <div class="dc-chat-header">
                    <a href="/messages" class="dc-icon-btn dc-mobile-only" data-tip="Back"><svg class="ic" width="22" height="22"><use href="#i-back"/></svg></a>
                    <span class="dc-avatar s24"><img src="/u/@partner/avatar" alt=""><i class="dc-status @status"></i></span>
                    <h1 class="dc-chat-title">@partnerName</h1>
                    <div class="dc-chat-tools">
                        <button type="button" class="dc-icon-btn" data-tip="Start Voice Call" data-inert><svg class="ic" width="22" height="22"><use href="#i-phone"/></svg></button>
                        <button type="button" class="dc-icon-btn dc-desktop-only" data-tip="Start Video Call" data-inert><svg class="ic" width="22" height="22"><use href="#i-video"/></svg></button>
                        <button type="button" class="dc-icon-btn dc-desktop-only" data-popover="dc-pins" data-tip="Pinned Messages"><svg class="ic" width="22" height="22"><use href="#i-pin"/></svg></button>
                        <button type="button" class="dc-icon-btn dc-desktop-only" data-popover="dc-new-dm" data-tip="Add Friends to DM"><svg class="ic" width="22" height="22"><use href="#i-user-add"/></svg></button>
                        <button type="button" class="dc-icon-btn selected dc-desktop-only" data-toggle-members data-tip="Hide User Profile"><svg class="ic" width="22" height="22"><use href="#i-members"/></svg></button>
                        <label class="dc-search dc-desktop-only">
                            <input type="text" class="dc-search-input" placeholder="Search" aria-label="Search">
                            <svg class="ic" width="16" height="16"><use href="#i-search"/></svg>
                        </label>
                    </div>
                    <div class="dc-popover dc-panel dc-pins" id="dc-pins" hidden>
                        <div class="dc-panel-head"><svg class="ic" width="20" height="20"><use href="#i-pin"/></svg><strong>Pinned Messages</strong></div>
                        <div class="dc-empty"><strong>This direct message doesn't have any pinned messages... yet.</strong></div>
                    </div>
                </div>

                <div class="dc-chat-body">
                    <div class="dc-chat-main">
                        <div class="messages-list conversation-messages">
                            @foreach (var row in rows)
                            {
                                var m = row.Message;
                                <div class="message@(row.Grouped ? " grouped" : "")">
                                    @if (row.Grouped)
                                    {
                                        <time class="message-gutter-time" datetime="@iso(m.CreatedUtc)" data-f="time">@time(m.CreatedUtc)</time>
                                    }
                                    else
                                    {
                                        <a href="/u/@m.FromUsername" class="message-avatar-link"><img src="/u/@m.FromUsername/avatar" alt="" class="message-avatar"></a>
                                    }
                                    <div class="message-content">
                                        @if (!row.Grouped)
                                        {
                                            <h3 class="message-header">
                                                <a href="/u/@m.FromUsername" class="message-author dc-name">@Present.DisplayName(m.FromUsername)</a>
                                                <time class="message-timestamp" datetime="@iso(m.CreatedUtc)" data-f="stamp">@stamp(m.CreatedUtc)</time>
                                            </h3>
                                        }
                                        <div class="message-text">@MessageHtml.Render(m.Message)</div>
                                    </div>
                                    <div class="message-actions">
                                        <button type="button" class="message-action" data-reply data-tip="Reply"><svg class="ic" width="20" height="20"><use href="#i-reply"/></svg></button>
                                        <button type="button" class="message-action" data-message-menu data-tip="More"><svg class="ic" width="20" height="20"><use href="#i-more"/></svg></button>
                                    </div>
                                </div>
                                if (row.NewDay)
                                {
                                    <div class="dc-divider" role="separator"><time datetime="@iso(m.CreatedUtc)" data-f="day">@day(m.CreatedUtc)</time></div>
                                }
                            }
                            <div class="dc-channel-start dc-dm-start">
                                <span class="dc-avatar s80"><img src="/u/@partner/avatar" alt=""></span>
                                <h2>@partnerName</h2>
                                <div class="dc-dm-start-handle">@partner</div>
                                <p>This is the beginning of your direct message history with <strong>@partnerName</strong>.</p>
                                <div class="dc-dm-start-actions">
                                    <span class="dc-dm-start-mutual"><span class="dc-titlebar-icon org">@world.ShortName[..1]</span>1 Mutual Server</span>
                                    <a href="/u/@partner" class="dc-btn">View Profile</a>
                                    <button type="button" class="dc-btn" data-inert>Block</button>
                                </div>
                            </div>
                        </div>

                        <div class="message-input-container">
                            <div class="dc-reply-bar" hidden>
                                <span>Replying to <strong class="dc-reply-name"></strong></span>
                                <button type="button" class="dc-icon-btn" data-reply-cancel data-tip="Cancel Reply"><svg class="ic" width="16" height="16"><use href="#i-close"/></svg></button>
                            </div>
                            <form method="post" action="/messages/send" class="conversation-input-form">
                                <input type="hidden" name="toUsername" value="@partner">
                                <div class="message-input-wrapper">
                                    <button type="button" class="attachment-btn" data-popover="dc-upload-menu" data-tip="Upload a File or Use Apps"><svg class="ic" width="24" height="24"><use href="#i-plus-circle"/></svg></button>
                                    <div class="dc-popover dc-menu dc-upload-menu" id="dc-upload-menu" hidden>
                                        <button type="button" class="dc-menu-item" data-inert><svg class="ic" width="20" height="20"><use href="#i-upload"/></svg> Upload a File</button>
                                        <button type="button" class="dc-menu-item" data-inert><svg class="ic" width="20" height="20"><use href="#i-apps"/></svg> Use Apps</button>
                                    </div>
                                    <div class="input-area">
                                        <input type="text" name="message" class="conversation-input" placeholder="Message @@@partnerName" required autocomplete="off" aria-label="Message">
                                        <div class="input-actions">
                                            <button type="button" class="input-action" data-popover="dc-gift" data-tip="Upgrade your friends! Gift them awesome chat perks with Discord Nitro"><svg class="ic" width="24" height="24"><use href="#i-gift"/></svg></button>
                                            <button type="button" class="input-action" data-picker="gif" data-tip="Open GIF picker"><svg class="ic" width="24" height="24"><use href="#i-gif"/></svg></button>
                                            <button type="button" class="input-action" data-picker="sticker" data-tip="Open sticker picker"><svg class="ic" width="24" height="24"><use href="#i-sticker"/></svg></button>
                                            <button type="button" class="input-action" data-picker="emoji" data-tip="Select emoji"><svg class="ic" width="24" height="24"><use href="#i-emoji"/></svg></button>
                                            <button type="submit" class="conversation-send-btn" data-tip="Send"><svg class="ic" width="20" height="20"><use href="#i-forward"/></svg></button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                            <div class="dc-popover dc-gift" id="dc-gift" hidden>
                                <strong>Gift Nitro</strong>
                                <p>Gifting is not available for your account right now.</p>
                            </div>
                            <div class="dc-typing"></div>
                        </div>
                    </div>

                    <aside class="dc-members dc-dm-profile" style="--banner: @banners[hash % (uint)banners.Length]">
                        <div class="dc-dm-profile-banner"></div>
                        <span class="dc-avatar s80"><img src="/u/@partner/avatar" alt=""><i class="dc-status @status" data-tip="@presenceLabel(status)"></i></span>
                        <h2 class="dc-profile-name">@partnerName</h2>
                        <div class="dc-profile-handle">@partner</div>
                        @if (activity(partner) != null)
                        {
                            <div class="dc-profile-bubble">@activity(partner)</div>
                        }
                        <div class="dc-dm-profile-card">
                            <h3 class="dc-profile-label">About Me</h3>
                            <p class="dc-profile-about">@Present.Headline(partner)</p>
                            <h3 class="dc-profile-label">Member Since</h3>
                            <p class="dc-profile-about">@since(partner, 2016, 2024).ToString("MMM d, yyyy", us)</p>
                        </div>
                        <div class="dc-dm-profile-card dc-dm-profile-links">
                            <a href="/u/@partner">Mutual Servers — 1 <svg class="ic" width="16" height="16"><use href="#i-chevron-right"/></svg></a>
                            <a href="/u/@partner">Mutual Friends — @(1 + hash % 6) <svg class="ic" width="16" height="16"><use href="#i-chevron-right"/></svg></a>
                        </div>
                        <a href="/u/@partner" class="dc-dm-profile-full">View Full Profile</a>
                    </aside>
                </div>
            </main>
        </div>
        @await Html.PartialAsync("~/Views/Themes/discord/_discorduserpanel.cshtml")
        <div class="dc-scrim" data-drawer-close></div>
    </div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/themes/discord/js/discord.js"></script>
</body>
</html>
