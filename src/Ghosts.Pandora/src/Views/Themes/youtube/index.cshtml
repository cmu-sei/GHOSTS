@{
    Layout = null;
    ViewBag.Theme = "youtube";
    var me = ViewBag.Username as string ?? string.Empty;
    var posts = Model ?? new List<Ghosts.Pandora.Infrastructure.Models.Post>();

    // The catch-all route renders this view for every feed URL, so the guide entry and heading follow the path
    var path = Context.Request.Path.Value?.TrimEnd('/').ToLowerInvariant() ?? string.Empty;
    var list = Context.Request.Query["list"].ToString();
    var (active, heading) = path switch
    {
        "" => ("home", null),
        "/shorts" => ("shorts", null),
        "/feed/subscriptions" => ("subscriptions", "Latest"),
        "/feed/you" => ("you", "History"),
        "/feed/history" => ("history", "Watch history"),
        "/feed/playlists" => ("playlists", "Playlists"),
        "/playlist" when list == "LL" => ("liked", "Liked videos"),
        "/playlist" when list == "WL" => ("watchlater", "Watch later"),
        _ => (string.Empty, null)
    };
    ViewData["ytActive"] = active;

    if (active == "subscriptions")
        posts = posts.Where(p => !string.Equals(p.Username, me, StringComparison.OrdinalIgnoreCase)).ToList();
    if (active == "liked")
        posts = posts.Where(p => p.Likes?.Any(l => string.Equals(l.Username, me, StringComparison.OrdinalIgnoreCase)) == true).ToList();
    if (active == "watchlater")
        posts = new List<Ghosts.Pandora.Infrastructure.Models.Post>();

    var chips = new[] { "All", "Music", "Gaming", "News", "Live", "Mixes", "Podcasts", Present.World.City, "Cooking", "Computer programming", "Recently uploaded", "Watched", "New to you" };
}
@model List<Ghosts.Pandora.Infrastructure.Models.Post>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="current-user" content="@me">
    <title>@(heading == null ? "YouTube" : $"{heading} - YouTube")</title>
    <link rel="stylesheet" href="/themes/youtube/css/feed.css?@System.Guid.NewGuid()">
    <link rel="icon" href="/themes/youtube/images/youtube-icon.svg" type="image/svg+xml">
</head>
<body data-theme="youtube" class="yt-browse-page">
    @await Html.PartialAsync("~/Views/Themes/youtube/_masthead.cshtml")
    @await Html.PartialAsync("~/Views/Themes/youtube/_guide.cshtml")

    <main class="yt-page-manager">
        @if (heading == null)
        {
            <div class="yt-chips-bar">
                <div class="yt-chips">
                    @for (var i = 0; i < chips.Length; i++)
                    {
                        <button class="yt-chip@(i == 0 ? " selected" : "")" type="button">@chips[i]</button>
                    }
                </div>
                <button class="yt-icon-btn yt-chips-next" type="button" aria-label="Next"><svg class="yt-icon"><use href="#yt-i-chevron-right"/></svg></button>
            </div>
        }
        else
        {
            <div class="yt-feed-header">
                <h1>@heading</h1>
                @if (active == "subscriptions")
                {
                    <a class="yt-text-btn yt-link" href="/feed/channels">Manage</a>
                }
            </div>
        }

        <div class="yt-rich-grid" id="newsfeed-items-grid">
            @foreach (var post in posts)
            {
                await Html.RenderPartialAsync("~/Views/Themes/youtube/_postcard.cshtml", post);
            }
        </div>

        @if (posts.Count == 0)
        {
            <div class="yt-empty">
                <svg class="yt-icon"><use href="#yt-i-@(active == "liked" ? "like" : active == "watchlater" ? "clock" : "your-videos")"/></svg>
                <h2>@(active == "liked" ? "No liked videos yet" : active == "watchlater" ? "No videos in this playlist yet" : "No videos yet")</h2>
                <p>@(active == "liked" ? "Tap the like button on videos you enjoy and they will show up here." : "Videos you save will show up here.")</p>
            </div>
        }
    </main>

    @await Html.PartialAsync("_Scripts")
    <script src="/themes/youtube/js/youtube.js?@System.Guid.NewGuid()"></script>
</body>
</html>
