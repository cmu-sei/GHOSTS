{
    "ConnectionStrings": {
        "DefaultConnection": "Host=ghosts-postgres;Port=5432;Database=ghosts;User Id=ghosts;Password=Scotty@@1!;"
    },
    "Logging": {
        "IncludeScopes": false,
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "System": "Warning",
            "Microsoft.EntityFrameworkCore.Database.Command": "Error"
        }
    },
    "ApplicationSettings": {
        "OfflineAfterMinutes": 30,
        "LookbackRecords": 5,
        "MatchMachinesBy": "name",
        "QueueSyncDelayInSeconds": 10,
        "NotificationsQueueSyncDelayInSeconds": 10,
        "ListenerPort": 8443,
        "SeedNpcCount": 20,
        "Grouping": {
            "GroupDepth": 3,
            "GroupDelimiters": [
                "-"
            ],
            "GroupName": "{domain}-{host}",
            "GroupingDefinition": [
                {
                    "Value": "domain",
                    "Direction": "LeftToRight",
                    "Replacements": {
                        ".": "-",
                        "^": "-"
                    }
                },
                {
                    "Value": "host",
                    "Direction": "LeftToRight",
                    "Replacements": {
                        ".": "-",
                        "^": "-"
                    }
                }
            ]
        },
        "AnimatorSettings": {
            "Proxy": ""
        }
    },
    "InitSettings": {
        "AdminUsername": "scotty@cert.org",
        "AdminPassword": "Password@1"
    },
    "NpcChat": {
        "ContentEngine": {
            "Source": "ollama",
            "Host": "http://host.docker.internal:11434",
            "Model": "gemma4:31b"
        },
        "SocialHost": "http://localhost:8800"
    },
    "ScenarioAuthoring": {
        "Region": "us-east-1",
        "Model": "us.anthropic.claude-sonnet-5-5",
        "Models": [
            {
                "Name": "Sonnet 5.5", "Id": "us.anthropic.claude-sonnet-5-5", "Efforts": [ "low", "medium", "high", "xhigh", "max" ],
                "Pricing": { "InputPerMillion": 2.00, "OutputPerMillion": 10.00, "CacheReadPerMillion": 0.20, "CacheWritePerMillion": 2.50 }
            },
            {
                "Name": "Opus 5.5", "Id": "us.anthropic.claude-opus-5-5", "Efforts": [ "low", "medium", "high", "xhigh", "max" ],
                "Pricing": { "InputPerMillion": 4.00, "OutputPerMillion": 20.00, "CacheReadPerMillion": 0.20, "CacheWritePerMillion": 5.00 }
            },
            {
                "Name": "Fable 5.1", "Id": "us.anthropic.claude-fable-5-1", "Efforts": [ "low", "medium", "high", "xhigh", "max" ],
                "Pricing": { "InputPerMillion": 10.00, "OutputPerMillion": 50.00, "CacheReadPerMillion": 0.25, "CacheWritePerMillion": 12.50 }
            }
        ],
        "FallbackModel": "",
        "MaxOutputTokens": 64000,
        "PromptCaching": true,
        "RequestTimeoutSeconds": 300,
        "TurnTimeoutMinutes": 30,
        "ValidatorTimeoutSeconds": 90
    },
    "Identity": {
        "UserHeader": "X-Forwarded-User"
    },
    "CorsPolicy": {
        "Origins": [
            "http://localhost:4200"
        ],
        "Methods": [],
        "Headers": [],
        "AllowAnyOrigin": false,
        "AllowAnyMethod": true,
        "AllowAnyHeader": true,
        "SupportsCredentials": true
    }
}
