@model Ghosts.Pandora.Infrastructure.Models.Post
@inject Ghosts.Pandora.Infrastructure.Services.IPostService Posts
@inject Ghosts.Pandora.Infrastructure.Services.IUserService Users
@inject Ghosts.Pandora.Infrastructure.Services.IFollowService Follows
@functions {
    // A stable, plausible subscriber count for a channel
    static int Subscribers(string username)
    {
        var unit = Ghosts.Pandora.Infrastructure.Content.ContentRequest.StableHash($"{username}:subscribers") % 10000 / 10000d;
        return 80 + (int)(unit * unit * unit * 480000);
    }

    // A stable like count for a comment; most get none
    static int CommentLikes(Ghosts.Pandora.Infrastructure.Models.Comment c)
    {
        var unit = Ghosts.Pandora.Infrastructure.Content.ContentRequest.StableHash($"comment:{c.Id}:{c.PostId}") % 1000 / 1000d;
        return unit < .3 ? 0 : (int)(unit * unit * unit * 240);
    }
}
@{
    Layout = null;
    ViewBag.Theme = "youtube";
    ViewData["ytActive"] = string.Empty;
    var me = ViewBag.Username as string ?? string.Empty;

    var title = Model != null ? Present.Title(Model) : "Video unavailable";
    var isOwner = Model != null && string.Equals(Model.Username, me, StringComparison.OrdinalIgnoreCase);
    var liked = Model != null && !string.IsNullOrWhiteSpace(me) &&
        (Model.Likes?.Any(l => string.Equals(l.Username, me, StringComparison.OrdinalIgnoreCase)) ?? false);

    var related = new List<Ghosts.Pandora.Infrastructure.Models.Post>();
    var subscribed = false;
    var comments = new List<Ghosts.Pandora.Infrastructure.Models.Comment>();
    if (Model != null)
    {
        related = (await Posts.GetLatestPostsByTheme("youtube", 30)).Where(p => p.Id != Model.Id).Take(20).ToList();

        var meUser = string.IsNullOrWhiteSpace(me) ? null : await Users.GetUserByUsernameAsync(me, "youtube");
        if (!isOwner && meUser != null && Model.User != null)
            subscribed = await Follows.IsFollowingAsync(meUser.Id, Model.User.Id);

        // "Top comments": the ones with the most likes first, newest breaking ties
        comments = (Model.Comments ?? new List<Ghosts.Pandora.Infrastructure.Models.Comment>())
            .OrderByDescending(c => CommentLikes(c))
            .ThenByDescending(c => c.CreatedUtc)
            .ToList();
    }

    var hashtags = Model == null ? new List<string>() :
        System.Text.RegularExpressions.Regex.Matches(SocialPresentation.PlainText(Model), @"#\w+").Select(m => m.Value).Distinct().Take(3).ToList();
    var durationText = Model != null ? Present.Duration(Model.Id) : "0:00";
    var durationSeconds = durationText.Split(':').Aggregate(0, (total, part) => total * 60 + int.Parse(part));
    var next = related.FirstOrDefault();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="current-user" content="@me">
    <title>@title - YouTube</title>
    <link rel="stylesheet" href="/themes/youtube/css/feed.css?@System.Guid.NewGuid()">
    <link rel="stylesheet" href="/themes/youtube/css/video.css?@System.Guid.NewGuid()">
    <link rel="icon" href="/themes/youtube/images/youtube-icon.svg" type="image/svg+xml">
</head>
<body data-theme="youtube" class="yt-watch-page">
    @await Html.PartialAsync("~/Views/Themes/youtube/_masthead.cshtml")
    @await Html.PartialAsync("~/Views/Themes/youtube/_guide.cshtml")

    <main class="yt-page-manager yt-watch">
        @if (Model == null)
        {
            <div class="yt-unavailable">
                <div class="yt-unavailable-player">
                    <svg viewBox="0 0 24 24" class="yt-icon"><use href="#yt-i-block"/></svg>
                    <p>Video unavailable</p>
                    <span>This video isn't available anymore</span>
                </div>
                <a class="yt-pill" href="/">Go to home</a>
            </div>
        }
        else
        {
            <div class="yt-watch-columns">
                <div class="yt-primary">
                    <div class="yt-player" data-duration="@durationSeconds">
                        <video class="yt-video" poster="@Present.PhotoUrl(Model)" src="/video/watch/@(Model.Id).mp4" preload="metadata" playsinline></video>
                        <div class="yt-player-surface"></div>
                        <button class="yt-large-play" type="button" aria-label="Play">
                            <svg viewBox="0 0 68 48"><path class="yt-large-play-bg" d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z"/><path d="M45 24 27 14v20" fill="#fff"/></svg>
                        </button>
                        <div class="yt-spinner"></div>
                        <div class="yt-player-gradient"></div>
                        <div class="yt-player-controls">
                            <div class="yt-progress">
                                <div class="yt-progress-list"><div class="yt-progress-loaded"></div><div class="yt-progress-played"></div></div>
                                <div class="yt-progress-scrubber"></div>
                            </div>
                            <div class="yt-controls-row">
                                <div class="yt-controls-left">
                                    <button class="yt-player-btn yt-play-btn" type="button" title="Play (k)"><svg class="yt-icon"><use href="#yt-i-play"/></svg></button>
                                    @if (next != null)
                                    {
                                        <a class="yt-player-btn yt-next-btn" href="/posts/@next.Id" title="Next (SHIFT+n)"><svg class="yt-icon"><use href="#yt-i-next"/></svg></a>
                                    }
                                    <button class="yt-player-btn yt-mute-btn" type="button" title="Mute (m)"><svg class="yt-icon"><use href="#yt-i-volume"/></svg></button>
                                    <div class="yt-volume-slider"><span></span></div>
                                    <div class="yt-time"><span class="yt-time-current">0:00</span><span class="yt-time-sep"> / </span><span>@durationText</span></div>
                                </div>
                                <div class="yt-controls-right">
                                    <button class="yt-player-btn yt-autoplay on" type="button" title="Autoplay is on"><span class="yt-autoplay-track"><span class="yt-autoplay-knob"><svg viewBox="0 0 24 24"><use href="#yt-i-play"/></svg></span></span></button>
                                    <button class="yt-player-btn yt-cc-btn" type="button" title="Subtitles/closed captions (c)"><svg class="yt-icon"><use href="#yt-i-cc"/></svg></button>
                                    <button class="yt-player-btn yt-settings-btn" type="button" title="Settings"><svg class="yt-icon"><use href="#yt-i-gear-fill"/></svg><span class="yt-hd-badge">HD</span></button>
                                    <button class="yt-player-btn yt-miniplayer-btn" type="button" title="Miniplayer (i)"><svg class="yt-icon"><use href="#yt-i-miniplayer"/></svg></button>
                                    <button class="yt-player-btn yt-theater-btn" type="button" title="Theater mode (t)"><svg class="yt-icon"><use href="#yt-i-theater"/></svg></button>
                                    <button class="yt-player-btn yt-fullscreen-btn" type="button" title="Full screen (f)"><svg class="yt-icon"><use href="#yt-i-fullscreen"/></svg></button>
                                </div>
                            </div>
                        </div>
                        <div class="yt-player-settings" hidden>
                            <div><span>Stable Volume</span><b>On</b></div>
                            <div><span>Ambient mode</span><b>On</b></div>
                            <div><span>Subtitles/CC</span><b>Off</b></div>
                            <div><span>Sleep timer</span><b>Off</b></div>
                            <div><span>Playback speed</span><b>Normal</b></div>
                            <div><span>Quality</span><b>Auto (1080p HD)</b></div>
                        </div>
                    </div>

                    <h1 class="yt-watch-title">@title</h1>

                    <div class="yt-watch-top-row">
                        <div class="yt-owner">
                            <a href="/u/@Model.Username"><img class="yt-owner-avatar" src="/u/@Model.Username/avatar" alt=""></a>
                            <div class="yt-owner-text">
                                <a class="yt-owner-name" href="/u/@Model.Username" data-username="@Model.Username" data-display-name>@Present.DisplayName(Model.Username)</a>
                                <div class="yt-owner-subs">@SocialPresentation.Compact(Subscribers(Model.Username)) subscribers</div>
                            </div>
                            @if (isOwner)
                            {
                                <button class="yt-pill" type="button" data-toast="Analytics are available in YouTube Studio">Analytics</button>
                                <button class="yt-pill" type="button" data-open-upload>Edit video</button>
                            }
                            else
                            {
                                <button class="yt-pill yt-subscribe" type="button" data-username="@Model.Username" data-subscribed="@(subscribed ? "true" : "false")">Subscribe</button>
                            }
                        </div>
                        <div class="yt-actions">
                            <div class="yt-like-group">
                                <button class="yt-like-btn like-it@(liked ? " liked" : "")" type="button" data-id="@Model.Id" data-count="@Present.Score(Model)" data-liked="@(liked ? "true" : "false")" aria-pressed="@(liked ? "true" : "false")" title="I like this">
                                    <svg class="yt-icon"><use href="#yt-i-@(liked ? "like-fill" : "like")"/></svg><span>@SocialPresentation.Compact(Present.Score(Model))</span>
                                </button>
                                <button class="yt-dislike-btn" type="button" title="I dislike this"><svg class="yt-icon"><use href="#yt-i-dislike"/></svg></button>
                            </div>
                            <button class="yt-pill yt-action-share" type="button" data-id="@Model.Id"><svg class="yt-icon"><use href="#yt-i-share"/></svg>Share</button>
                            <button class="yt-pill yt-action-download" type="button" data-toast="Get YouTube Premium to download videos"><svg class="yt-icon"><use href="#yt-i-download"/></svg>Download</button>
                            <button class="yt-pill yt-action-save" type="button" data-toast="Saved to Watch later"><svg class="yt-icon"><use href="#yt-i-save"/></svg>Save</button>
                            <button class="yt-pill yt-action-more" type="button" data-toast="Thanks for reporting" aria-label="More actions"><svg class="yt-icon"><use href="#yt-i-more"/></svg></button>
                        </div>
                    </div>

                    <div class="yt-description">
                        <div class="yt-description-info">
                            <span class="yt-when-collapsed">@SocialPresentation.Compact(Present.Views(Model)) views&nbsp;&nbsp;@SocialPresentation.LongAgo(Model.CreatedUtc)</span>
                            <span class="yt-when-expanded">@Present.Views(Model).ToString("N0") views&nbsp;&nbsp;@Model.CreatedUtc.ToString("MMM d, yyyy")</span>
                            @foreach (var tag in hashtags)
                            {
                                <a class="yt-hashtag" href="/search?q=@Uri.EscapeDataString(tag.TrimStart('#'))">@tag</a>
                            }
                        </div>
                        <div class="yt-description-snippet"><span class="yt-description-text">@MessageHtml.Render(Model.Message)</span> <span class="yt-description-more">...more</span></div>
                        <div class="yt-description-extra">
                            <a class="yt-description-channel" href="/u/@Model.Username">
                                <img src="/u/@Model.Username/avatar" alt="">
                                <span><b>@Present.DisplayName(Model.Username)</b><small>@SocialPresentation.Compact(Subscribers(Model.Username)) subscribers</small></span>
                            </a>
                            <div class="yt-description-links">
                                <a class="yt-pill" href="/u/@Model.Username"><svg class="yt-icon"><use href="#yt-i-your-videos"/></svg>Videos</a>
                                <a class="yt-pill" href="/u/@Model.Username"><svg class="yt-icon"><use href="#yt-i-account"/></svg>About</a>
                            </div>
                            <button class="yt-text-btn yt-description-less" type="button">Show less</button>
                        </div>
                    </div>

                    <section class="yt-comments" data-post-id="@Model.Id">
                        <div class="yt-comments-header">
                            <h2 class="yt-comments-count" data-count="@comments.Count">@comments.Count.ToString("N0") Comment@(comments.Count == 1 ? "" : "s")</h2>
                            <div class="yt-popup-anchor">
                                <button class="yt-comments-sort" type="button"><svg class="yt-icon"><use href="#yt-i-sort"/></svg>Sort by</button>
                                <div class="yt-popup yt-sort-menu" id="yt-sort-menu" hidden>
                                    <button class="yt-menu-item checked" type="button" data-sort="top">Top comments</button>
                                    <button class="yt-menu-item" type="button" data-sort="newest">Newest first</button>
                                </div>
                            </div>
                        </div>

                        <div class="yt-add-comment add-comment">
                            <img class="yt-add-comment-avatar" src="/u/@me/avatar" alt="">
                            <div class="yt-add-comment-box">
                                <input class="comment-input" type="text" placeholder="Add a comment..." autocomplete="off" maxlength="2000">
                                <button class="yt-icon-btn yt-emoji-btn" type="button" aria-label="Emoji"><svg class="yt-icon"><use href="#yt-i-emoji"/></svg></button>
                                <span class="yt-flex-spacer"></span>
                                <button class="yt-text-btn yt-comment-cancel" type="button">Cancel</button>
                                <button class="yt-pill yt-pill-blue comment-post-btn" type="button" disabled>Comment</button>
                            </div>
                        </div>

                        <div class="comments-list">
                            @foreach (var comment in comments)
                            {
                                var likes = CommentLikes(comment);
                                var byOwner = string.Equals(comment.Username, Model.Username, StringComparison.OrdinalIgnoreCase);
                                <div class="yt-comment" data-created="@comment.CreatedUtc.ToString("o")" data-likes="@likes">
                                    <a class="yt-comment-avatar" href="/u/@comment.Username"><img src="/u/@comment.Username/avatar" alt=""></a>
                                    <div class="yt-comment-body">
                                        <div class="yt-comment-head">
                                            <a class="yt-comment-author@(byOwner ? " owner" : "")" href="/u/@comment.Username">@Present.Handle(comment.Username)</a>
                                            <span class="yt-comment-time">@SocialPresentation.LongAgo(comment.CreatedUtc)</span>
                                        </div>
                                        <div class="yt-comment-text">@MessageHtml.Render(comment.Message)</div>
                                        <div class="yt-comment-toolbar">
                                            <button class="yt-icon-btn yt-comment-like" type="button" aria-label="Like this comment"><svg class="yt-icon"><use href="#yt-i-like"/></svg></button><span class="yt-comment-likes">@(likes > 0 ? SocialPresentation.Compact(likes) : "")</span>
                                            <button class="yt-icon-btn yt-comment-dislike" type="button" aria-label="Dislike this comment"><svg class="yt-icon"><use href="#yt-i-dislike"/></svg></button>
                                            <button class="yt-text-btn yt-comment-reply" type="button">Reply</button>
                                        </div>
                                    </div>
                                    <button class="yt-icon-btn yt-comment-menu" type="button" aria-label="Action menu"><svg class="yt-icon"><use href="#yt-i-more-vert"/></svg></button>
                                </div>
                            }
                        </div>
                    </section>
                </div>

                <aside class="yt-secondary" aria-label="Up next">
                    <div class="yt-chips yt-related-chips">
                        <button class="yt-chip selected" type="button">All</button>
                        <button class="yt-chip" type="button">From @Present.DisplayName(Model.Username)</button>
                        <button class="yt-chip" type="button">Related</button>
                        <button class="yt-chip" type="button">For you</button>
                        <button class="yt-chip" type="button">Recently uploaded</button>
                        <button class="yt-chip" type="button">Watched</button>
                    </div>
                    @foreach (var video in related)
                    {
                        <div class="yt-compact-video" data-post-id="@video.Id">
                            <a class="yt-thumb" href="/posts/@video.Id" tabindex="-1" aria-hidden="true">
                                <img src="@Present.PhotoUrl(video)" alt="" loading="lazy">
                                <span class="yt-badge">@Present.Duration(video.Id)</span>
                            </a>
                            <a class="yt-compact-meta" href="/posts/@video.Id">
                                <h3 class="yt-compact-title">@Present.Title(video)</h3>
                                <span class="yt-compact-channel" data-username="@video.Username" data-display-name>@Present.DisplayName(video.Username)</span>
                                <span class="yt-stats"><span>@SocialPresentation.Compact(Present.Views(video)) views</span><span>@SocialPresentation.LongAgo(video.CreatedUtc)</span></span>
                            </a>
                            <button class="yt-icon-btn yt-card-menu" type="button" aria-label="Action menu"><svg class="yt-icon"><use href="#yt-i-more-vert"/></svg></button>
                        </div>
                    }
                </aside>
            </div>
        }
    </main>

    @await Html.PartialAsync("_Scripts")
    <script src="/themes/youtube/js/youtube.js?@System.Guid.NewGuid()"></script>
</body>
</html>
