@{
    Layout = null;
}
@model Ghosts.Pandora.Infrastructure.Models.User
@inject Ghosts.Pandora.Infrastructure.Services.IUserService Users
@{
    ViewBag.Theme = "facebook";
    var profileUsername = Model?.Username ?? (ViewContext.RouteData.Values["username"] as string)?.Trim();
    if (string.IsNullOrWhiteSpace(profileUsername))
    {
        profileUsername = Context.Request.Cookies["username"];
    }
    var isSelf = ViewBag.IsSelf as bool? ?? false;
    var isFollowing = ViewBag.IsFollowing as bool? ?? false;
    var posts = ViewBag.Posts as List<Post> ?? new List<Post>();
    var name = Present.DisplayName(profileUsername);
    var world = Present.World;

    int Stable(string key) => Math.Abs((key ?? string.Empty).Aggregate(17, (h, c) => unchecked(h * 31 + c)) % 100000);

    var worldUsers = new HashSet<string>(world.People.Select(p => p.Username ?? string.Empty), StringComparer.OrdinalIgnoreCase);
    var friends = (await Users.GetUsersByThemeAsync("facebook", 80))
        .Where(u => !string.Equals(u.Username, profileUsername, StringComparison.OrdinalIgnoreCase))
        .OrderBy(u => worldUsers.Contains(u.Username) ? 0 : 1)
        .ThenBy(u => Stable(profileUsername + u.Username))
        .ToList();
    var friendCount = Math.Max(friends.Count, 120 + Stable(profileUsername) % 880);

    var covers = new[] { "/img/top-header1.jpg", "/img/top-header2.jpg", "/img/video9.jpg", "/img/open-photo1.jpg" };
    var cover = covers[Stable(profileUsername) % covers.Length];

    var photoId = Model?.Id ?? Guid.Empty;
    var photos = posts.Where(p => Present.HasPhoto(p, 40)).Select(p => (Url: Present.PhotoUrl(p), Link: $"/posts/{p.Id}"))
        .Concat(Enumerable.Range(0, 12).Select(i => (Url: Present.PhotoUrl(photoId, i), Link: "#")))
        .DistinctBy(p => p.Url)
        .Take(9)
        .ToList();

    var bio = Model?.Bio;
    if (string.IsNullOrWhiteSpace(bio) || bio.StartsWith("User ", StringComparison.Ordinal))
    {
        bio = null;
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@name | Facebook</title>
    <link rel="stylesheet" href="/themes/facebook/css/facebook.css">
    <link rel="icon" href="/themes/facebook/images/favicon.svg" type="image/svg+xml">
</head>
<body data-theme="facebook" class="fb-page-profile">
    @await Html.PartialAsync("~/Views/Themes/facebook/_fbheader.cshtml")

    <div class="fb-profile-top">
        <div class="fb-profile-head">
            <div class="fb-cover" style="background-image:url('@cover')">
                @if (isSelf)
                {
                    <button type="button" class="fb-btn fb-cover-btn"><svg><use href="#fb-camera"></use></svg><span>Edit cover photo</span></button>
                }
            </div>
            <div class="fb-profile-info">
                <img src="/u/@profileUsername/avatar" alt="@name" class="fb-profile-avatar">
                <div class="fb-profile-name">
                    <h1>@name</h1>
                    <a href="#" class="fb-friend-count">@friendCount.ToString("N0") friends</a>
                    <div class="fb-friend-faces">
                        @for (var i = 0; i < Math.Min(8, friends.Count); i++)
                        {
                            <a href="/u/@friends[i].Username" title="@Present.DisplayName(friends[i].Username)" style="z-index:@(8 - i)"><img src="/u/@friends[i].Username/avatar" alt=""></a>
                        }
                    </div>
                </div>
                <div class="fb-profile-actions">
                    @if (isSelf)
                    {
                        <button type="button" class="fb-btn fb-btn-primary"><svg><use href="#fb-plus"></use></svg><span>Add to story</span></button>
                        <button type="button" class="fb-btn fb-btn-secondary"><svg><use href="#fb-pencil"></use></svg><span>Edit profile</span></button>
                    }
                    else
                    {
                        <form method="post" action="@(isFollowing ? "/api/relationships/unfollow" : "/api/relationships/follow")" class="fb-follow-form" data-following="@(isFollowing ? "true" : "false")">
                            <input type="hidden" name="username" value="@profileUsername">
                            @if (isFollowing)
                            {
                                <button type="submit" class="fb-btn fb-btn-secondary"><svg><use href="#fb-person-check"></use></svg><span>Friends</span></button>
                            }
                            else
                            {
                                <button type="submit" class="fb-btn fb-btn-primary"><svg><use href="#fb-person-add"></use></svg><span>Add friend</span></button>
                            }
                        </form>
                        <a href="/messages/conversation/@profileUsername" class="fb-btn fb-btn-secondary"><svg><use href="#fb-messenger"></use></svg><span>Message</span></a>
                    }
                    <button type="button" class="fb-btn fb-btn-secondary fb-profile-more" aria-label="See options"><svg><use href="#fb-chev-down"></use></svg></button>
                </div>
            </div>
            <div class="fb-profile-sep"></div>
            <nav class="fb-profile-tabs">
                <a href="/u/@profileUsername" class="fb-profile-tab active"><span>Posts</span></a>
                <a href="#" class="fb-profile-tab"><span>About</span></a>
                <a href="#" class="fb-profile-tab"><span>Friends</span></a>
                <a href="#" class="fb-profile-tab"><span>Photos</span></a>
                <a href="#" class="fb-profile-tab"><span>Videos</span></a>
                <a href="#" class="fb-profile-tab"><span>Check-ins</span></a>
                <a href="#" class="fb-profile-tab"><span>More</span><svg><use href="#fb-chev-down"></use></svg></a>
                <button type="button" class="fb-btn fb-btn-secondary" aria-label="Profile settings"><svg><use href="#fb-dots"></use></svg></button>
            </nav>
        </div>
    </div>

    <div class="fb-profile-body">
        <aside class="fb-profile-left">
            <section class="fb-card">
                <div class="fb-card-title"><h2>Intro</h2></div>
                @if (bio != null)
                {
                    <div class="fb-intro-bio">@bio</div>
                }
                <div class="fb-intro-item"><svg><use href="#fb-work"></use></svg><span>@Present.Headline(profileUsername)</span></div>
                <div class="fb-intro-item"><svg><use href="#fb-house"></use></svg><span>Lives in <strong>@world.City</strong></span></div>
                @if (isSelf)
                {
                    <div class="fb-intro-actions">
                        <button type="button" class="fb-btn fb-btn-secondary fb-btn-block">Edit details</button>
                        <button type="button" class="fb-btn fb-btn-secondary fb-btn-block">Add featured</button>
                    </div>
                }
            </section>

            <section class="fb-card">
                <div class="fb-card-title"><h2>Photos</h2><a href="#">See all photos</a></div>
                <div class="fb-photo-grid">
                    @foreach (var photo in photos)
                    {
                        <a href="@photo.Link"><img src="@photo.Url" alt="" loading="lazy"></a>
                    }
                </div>
            </section>

            @if (friends.Count > 0)
            {
                <section class="fb-card">
                    <div class="fb-card-title"><h2>Friends</h2><a href="#">See all friends</a></div>
                    <div class="fb-card-sub">@friendCount.ToString("N0") friends</div>
                    <div class="fb-friend-grid">
                        @foreach (var friend in friends.Take(9))
                        {
                            <a href="/u/@friend.Username" class="fb-friend-tile"><img src="/u/@friend.Username/avatar" alt="" loading="lazy"><span>@Present.DisplayName(friend.Username)</span></a>
                        }
                    </div>
                </section>
            }
            <footer class="fb-legal">Privacy · Terms · Advertising · Ad Choices · Cookies · More · Meta © @DateTime.UtcNow.Year</footer>
        </aside>

        <main class="fb-profile-main">
            @if (isSelf)
            {
                @await Html.PartialAsync("_CreatePost")
            }
            <div class="fb-card fb-posts-bar">
                <h2>Posts</h2>
                <div>
                    <button type="button" class="fb-btn fb-btn-secondary">Filters</button>
                    @if (isSelf)
                    {
                        <button type="button" class="fb-btn fb-btn-secondary">Manage posts</button>
                    }
                </div>
            </div>
            @foreach (var post in posts)
            {
                await Html.RenderPartialAsync("_PostCard", post);
            }
            @if (posts.Count == 0)
            {
                <div class="fb-card fb-feed-empty"><strong>No posts available</strong></div>
            }
        </main>
    </div>

    @await Html.PartialAsync("_Scripts")
    <script src="/themes/facebook/js/facebook.js"></script>
</body>
</html>
