@{
    Layout = null;
    ViewBag.Theme = "linkedin";
    ViewData["LiNav"] = "messaging";
    ViewData["LiPartner"] = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="current-user" content="@ViewBag.Username">
    <title>Messaging | LinkedIn</title>
    <link rel="stylesheet" href="/themes/linkedin/css/feed.css?@System.Guid.NewGuid()">
    <link rel="icon" href="/themes/linkedin/images/favicon.svg" type="image/svg+xml">
</head>
<body data-theme="linkedin" class="li-body li-body--messaging">
    @await Html.PartialAsync("~/Views/Themes/linkedin/_header.cshtml")

    <div class="li-page li-page--messaging">
        <main class="li-main">
            @await Html.PartialAsync("~/Views/Themes/linkedin/_messaging.cshtml")
        </main>
        <aside class="li-right">
            <div class="li-card li-msg-promo">
                <p>Get hired faster with Premium. See who’s viewed your profile and message recruiters directly.</p>
                <a href="#" class="li-btn li-btn--outline li-inert"><svg width="16" height="16"><use href="#li-premium"/></svg>Try Premium for $0</a>
            </div>
            @await Html.PartialAsync("~/Views/Themes/linkedin/_footer.cshtml")
        </aside>
    </div>

    <script src="/themes/linkedin/js/linkedin.js?@System.Guid.NewGuid()"></script>
</body>
</html>
