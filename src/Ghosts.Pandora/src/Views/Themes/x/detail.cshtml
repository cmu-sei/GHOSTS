@model Ghosts.Pandora.Infrastructure.Models.Post
@inject Ghosts.Pandora.Infrastructure.Services.IUserService Users
@inject Ghosts.Pandora.Infrastructure.Services.IFollowService Follows
@{
    Layout = null;
    ViewBag.Theme = "x";
    if (ViewBag.ProfileUsername == null && Model != null)
    {
        ViewBag.ProfileUsername = Model.Username;
    }

    var me = ViewBag.Username as string ?? "user";
    ViewData["XNav"] = "";
    ViewData["XAside"] = "post";
    ViewData["XPerson"] = Model?.Username;

    var author = Model?.Username ?? "";
    var isMe = string.Equals(author, me, StringComparison.OrdinalIgnoreCase);
    var liked = Model != null && (Model.Likes?.Any(l => string.Equals(l.Username, me, StringComparison.OrdinalIgnoreCase)) ?? false);
    var text = Model == null ? "" : SocialPresentation.UploadedImage(Model) != null ? SocialPresentation.PlainText(Model) : Model.Message;
    var photo = Model != null && Present.HasPhoto(Model, 25) ? Present.PhotoUrl(Model) : null;
    var replies = Model == null ? 0 : Present.CommentCount(Model);
    var reposts = Model == null ? 0 : Present.Shares(Model);
    var likes = Model == null ? 0 : Present.Score(Model);
    var views = Model == null ? 0 : Present.Views(Model);
    var comments = Model?.Comments?.OrderBy(c => c.CreatedUtc).ToList() ?? new List<Ghosts.Pandora.Infrastructure.Models.Comment>();
    string Count(int n) => n > 0 ? SocialPresentation.Compact(n) : "";

    var following = false;
    if (Model != null && !isMe)
    {
        var meUser = await Users.GetUserByUsernameAsync(me, "x");
        following = meUser != null && await Follows.IsFollowingAsync(meUser.Id, Model.UserId);
    }

    var plain = Model == null ? "" : SocialPresentation.PlainText(Model);
    var title = Model == null ? "Post / X" : $"{Present.DisplayName(author)} on X: \"{(plain.Length > 80 ? plain[..80] + "…" : plain)}\" / X";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="current-user" content="@me">
    <title>@title</title>
    <link rel="stylesheet" href="/themes/x/css/x.css?@System.Guid.NewGuid()">
    <link rel="icon" href="/themes/x/images/favicon.svg" type="image/svg+xml">
</head>
<body data-theme="x">
    @await Html.PartialAsync("/Views/Themes/x/_xsprite.cshtml")
    <div class="x-app">
        @await Html.PartialAsync("/Views/Themes/x/_xnav.cshtml")
        <main class="x-main" role="main">
            <div class="x-main-inner">
                <div class="x-primary">
                    <div class="x-sticky">
                        <div class="x-topbar">
                            <a href="/" class="x-back" aria-label="Back" onclick="if (history.length > 1) { history.back(); return false; }"><svg><use href="#x-back"/></svg></a>
                            <h2>Post</h2>
                        </div>
                    </div>

                    @if (Model == null)
                    {
                        <div class="x-empty">
                            <h2>Hmm...this page doesn’t exist.</h2>
                            <p>Try searching for something else.</p>
                            <a href="/search" class="x-btn-dark">Search</a>
                        </div>
                    }
                    else
                    {
                        <article class="x-focal" data-post-id="@Model.Id" data-username="@author">
                            <div class="x-focal-head">
                                <a href="/u/@author"><img src="/u/@author/avatar" alt="" class="x-who-avatar"></a>
                                <div class="x-focal-names">
                                    <a href="/u/@author" class="tweet-name">@Present.DisplayName(author)</a>
                                    <a href="/u/@author" class="tweet-handle">@Present.Handle(author)</a>
                                </div>
                                <div class="x-focal-tools">
                                    @if (!isMe)
                                    {
                                        <button type="button" class="x-follow@(following ? " following" : "")" data-x-follow="@author">@(following ? "Following" : "Follow")</button>
                                    }
                                    <button type="button" class="x-icon-btn" aria-label="Grok actions"><svg><use href="#x-grok"/></svg></button>
                                    <button type="button" class="x-icon-btn" aria-label="More" data-x-menu="post"><svg><use href="#x-dots"/></svg></button>
                                </div>
                            </div>

                            <div class="x-focal-text">@MessageHtml.Render(text)</div>
                            @if (photo != null)
                            {
                                <div class="tweet-media"><img src="@photo" alt="Image"></div>
                            }

                            <div class="x-focal-meta">
                                <a href="/posts/@Model.Id"><time datetime="@Model.CreatedUtc.ToString("o")">@Model.CreatedUtc.ToString("h:mm tt · MMM d, yyyy")</time></a>
                                · <b>@SocialPresentation.Compact(views)</b> Views
                            </div>

                            <div class="x-focal-actions" role="group">
                                <button type="button" class="action-btn act-reply" aria-label="Reply" data-count="@replies" onclick="document.querySelector('.x-reply-box .comment-input').focus()"><span class="ab-ic"><svg><use href="#x-reply"/></svg></span><span class="ab-n">@Count(replies)</span></button>
                                <button type="button" class="action-btn act-repost" aria-label="Repost" data-count="@reposts"><span class="ab-ic"><svg><use href="#x-repost"/></svg></span><span class="ab-n">@Count(reposts)</span></button>
                                <button type="button" class="action-btn like-it@(liked ? " liked" : "")" aria-label="Like" data-id="@Model.Id" data-count="@likes"><span class="ab-ic"><svg class="ic-off"><use href="#x-like"/></svg><svg class="ic-on"><use href="#x-like-fill"/></svg></span><span class="ab-n">@Count(likes)</span></button>
                                <button type="button" class="action-btn act-bookmark" aria-label="Bookmark"><span class="ab-ic"><svg class="ic-off"><use href="#x-bookmark"/></svg><svg class="ic-on"><use href="#x-bookmark-fill"/></svg></span></button>
                                <button type="button" class="action-btn act-share" aria-label="Share post"><span class="ab-ic"><svg><use href="#x-share"/></svg></span></button>
                            </div>
                        </article>

                        @* social.js posts the reply: it needs .comment-input and .comment-post-btn as siblings inside .comment-input-container *@
                        <div class="x-reply-box comment-input-container" data-post-id="@Model.Id" data-empty>
                            <div class="x-reply-to">Replying to <a href="/u/@author">@Present.Handle(author)</a></div>
                            <img src="/u/@me/avatar" alt="" class="x-reply-avatar">
                            <textarea class="comment-input" placeholder="Post your reply" rows="1" maxlength="280"></textarea>
                            <div class="x-reply-tools">
                                <button type="button" class="option-btn" aria-label="Add photos or video"><svg><use href="#x-media"/></svg></button>
                                <button type="button" class="option-btn" aria-label="Add a GIF"><svg><use href="#x-gif"/></svg></button>
                                <button type="button" class="option-btn" aria-label="Enhance your post with Grok"><svg><use href="#x-grok"/></svg></button>
                                <button type="button" class="option-btn" aria-label="Add emoji"><svg><use href="#x-emoji"/></svg></button>
                                <button type="button" class="option-btn" aria-label="Tag location" disabled><svg><use href="#x-location"/></svg></button>
                            </div>
                            <button type="button" class="comment-post-btn">Reply</button>
                        </div>

                        <div class="x-replies">
                            @foreach (var comment in comments)
                            {
                                var who = comment.Username;
                                <article class="tweet" data-username="@who">
                                    <a href="/u/@who" class="tweet-avatar-link"><img src="/u/@who/avatar" alt="" class="tweet-avatar"></a>
                                    <div class="tweet-content">
                                        <div class="tweet-header">
                                            <a href="/u/@who" class="tweet-name">@Present.DisplayName(who)</a>
                                            <a href="/u/@who" class="tweet-handle">@Present.Handle(who)</a>
                                            <span class="tweet-dot">·</span>
                                            <span class="tweet-time" title="@comment.CreatedUtc.ToString("h:mm tt · MMM d, yyyy")">@SocialPresentation.ShortAgo(comment.CreatedUtc)</span>
                                            <div class="tweet-header-icons">
                                                <button type="button" class="x-icon-btn" aria-label="Grok actions"><svg><use href="#x-grok"/></svg></button>
                                                <button type="button" class="x-icon-btn" aria-label="More" data-x-menu="post"><svg><use href="#x-dots"/></svg></button>
                                            </div>
                                        </div>
                                        <div class="tweet-text">@MessageHtml.Render(comment.Message)</div>
                                        <div class="tweet-actions" role="group">
                                            <button type="button" class="action-btn act-reply" aria-label="Reply" onclick="document.querySelector('.x-reply-box .comment-input').focus()"><span class="ab-ic"><svg><use href="#x-reply"/></svg></span><span class="ab-n"></span></button>
                                            <button type="button" class="action-btn act-repost" aria-label="Repost" data-count="0"><span class="ab-ic"><svg><use href="#x-repost"/></svg></span><span class="ab-n"></span></button>
                                            <button type="button" class="action-btn act-like" aria-label="Like" data-count="0"><span class="ab-ic"><svg class="ic-off"><use href="#x-like"/></svg><svg class="ic-on"><use href="#x-like-fill"/></svg></span><span class="ab-n"></span></button>
                                            <span class="action-btn act-views"><span class="ab-ic"><svg><use href="#x-views"/></svg></span><span class="ab-n"></span></span>
                                            <div class="ab-end">
                                                <button type="button" class="action-btn act-bookmark" aria-label="Bookmark"><span class="ab-ic"><svg class="ic-off"><use href="#x-bookmark"/></svg><svg class="ic-on"><use href="#x-bookmark-fill"/></svg></span></button>
                                                <button type="button" class="action-btn act-share" aria-label="Share post"><span class="ab-ic"><svg><use href="#x-share"/></svg></span></button>
                                            </div>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </div>
                @await Html.PartialAsync("/Views/Themes/x/_xaside.cshtml")
            </div>
        </main>
    </div>

    <script>window.xNames = @Json.Serialize(Present.World.People.DistinctBy(p => p.Username).ToDictionary(p => p.Username, p => p.FullName));</script>
    @await Html.PartialAsync("_Scripts")
    <script src="/themes/x/js/x.js?@System.Guid.NewGuid()"></script>
</body>
</html>
