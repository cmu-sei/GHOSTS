<header class="fb-header">
    <div class="fb-header-left">
        <a href="/" class="logo" aria-label="Facebook"><svg class="fb-logo-mark" width="40" height="40"><use href="#fb-logo"></use></svg><span class="fb-wordmark">facebook</span></a>
        <form action="/search" method="get" class="fb-search" role="search">
            <svg class="fb-i fb-search-icon"><use href="#fb-search"></use></svg>
            <input type="text" name="q" value="@query" class="fb-search-input" placeholder="Search Facebook" aria-label="Search Facebook" autocomplete="off">
        </form>
    </div>

    <nav class="fb-header-tabs" aria-label="Facebook">
        <a href="/" class="fb-tab@(tab == "home" ? " active" : "")" aria-label="Home" title="Home">
            <svg class="fb-i"><use href="@(tab == "home" ? "#fb-home-fill" : "#fb-home")"></use></svg>
        </a>
        <a href="#" class="fb-tab" aria-label="Video" title="Video"><svg class="fb-i"><use href="#fb-video"></use></svg></a>
        <a href="#" class="fb-tab" aria-label="Marketplace" title="Marketplace"><svg class="fb-i"><use href="#fb-market"></use></svg></a>
        <a href="#" class="fb-tab" aria-label="Groups" title="Groups"><svg class="fb-i"><use href="#fb-groups"></use></svg></a>
        <a href="#" class="fb-tab" aria-label="Gaming" title="Gaming"><svg class="fb-i"><use href="#fb-gaming"></use></svg></a>
    </nav>

    <div class="fb-header-right">
        <a href="/search" class="fb-round-btn fb-narrow-only" aria-label="Search"><svg class="fb-i"><use href="#fb-search"></use></svg></a>
        <button type="button" class="fb-round-btn fb-desktop-only" aria-label="Menu" title="Menu"><svg class="fb-i"><use href="#fb-menu"></use></svg></button>
        <a href="/messages" class="fb-round-btn" aria-label="Messenger" title="Messenger">
            <svg class="fb-i"><use href="#fb-messenger"></use></svg>
            @if (unread > 0)
            {
                <span class="fb-badge">@(unread > 99 ? "99+" : unread.ToString())</span>
            }
        </a>
        <div class="fb-menu-wrap" data-fb-menu>
            <button type="button" class="fb-round-btn" aria-label="Notifications" title="Notifications" data-fb-menu-toggle>
                <svg class="fb-i"><use href="#fb-bell"></use></svg>
                @if (newNotes > 0)
                {
                    <span class="fb-badge">@newNotes</span>
                }
            </button>
            <div class="fb-dropdown fb-notifications" role="menu">
                <div class="fb-dropdown-title">Notifications</div>
                <div class="fb-chips"><button type="button" class="fb-chip active" data-fb-note-filter="all">All</button><button type="button" class="fb-chip" data-fb-note-filter="unread">Unread</button></div>
                @if (notes.Count == 0)
                {
                    <div class="fb-empty-note">You have no notifications</div>
                }
                @foreach (var note in notes)
                {
                    <a href="/posts/@note.Post" class="fb-note">
                        <span class="fb-note-avatar">
                            <img src="/u/@note.Who/avatar" alt="">
                            <svg class="fb-note-kind"><use href="@(note.Comment ? "#fb-note-comment" : "#fb-react-like")"></use></svg>
                        </span>
                        <span class="fb-note-body">
                            <span><strong>@Present.DisplayName(note.Who)</strong> @(note.What + (string.IsNullOrEmpty(note.Text) ? "." : ": " + (note.Text.Length > 70 ? note.Text[..70] + "…" : note.Text)))</span>
                            <span class="fb-note-time">@SocialPresentation.ShortAgo(note.When).Replace("now", "Just now")</span>
                        </span>
                        @if (note.When > DateTime.UtcNow.AddDays(-1))
                        {
                            <span class="fb-unread-dot"></span>
                        }
                    </a>
                }
            </div>
        </div>
        <div class="fb-menu-wrap" data-fb-menu>
            <button type="button" class="fb-account-btn" aria-label="Your profile" title="Your profile" data-fb-menu-toggle>
                <img src="/u/@me/avatar" alt="">
                <span class="fb-account-chevron"><svg><use href="#fb-chev-down"></use></svg></span>
            </button>
            <div class="fb-dropdown fb-account" role="menu">
                <div class="fb-account-card">
                    <a href="/u/@me" class="fb-account-me"><img src="/u/@me/avatar" alt=""><span>@myName</span></a>
                    <div class="fb-account-sep"></div>
                    <a href="/u/@me" class="fb-account-all">See all profiles</a>
                </div>
                <a href="#" class="fb-account-item"><span class="fb-account-icon"><svg><use href="#fb-gear"></use></svg></span>Settings &amp; privacy<svg class="fb-account-more"><use href="#fb-chev-right"></use></svg></a>
                <a href="#" class="fb-account-item"><span class="fb-account-icon"><svg><use href="#fb-help"></use></svg></span>Help &amp; support<svg class="fb-account-more"><use href="#fb-chev-right"></use></svg></a>
                <a href="#" class="fb-account-item"><span class="fb-account-icon"><svg><use href="#fb-moon"></use></svg></span>Display &amp; accessibility<svg class="fb-account-more"><use href="#fb-chev-right"></use></svg></a>
                <a href="#" class="fb-account-item"><span class="fb-account-icon"><svg><use href="#fb-feedback"></use></svg></span>Give feedback</a>
                <a href="#" class="fb-account-item"><span class="fb-account-icon"><svg><use href="#fb-logout"></use></svg></span>Log out</a>
                <div class="fb-legal">Privacy · Terms · Advertising · Ad Choices · Cookies · More · Meta © @DateTime.UtcNow.Year</div>
            </div>
        </div>
    </div>
</header>
<script>window.FB_NAMES = @Json.Serialize(names);</script>
