@{
    Layout = null;
    ViewBag.Theme = "youtube";
    ViewData["ytActive"] = string.Empty;
    var me = ViewBag.Username as string ?? string.Empty;
    var partner = ViewBag.PartnerUsername as string ?? string.Empty;
    ViewData["ytPartner"] = partner;
    var conversation = (ViewBag.Conversation as IEnumerable<Ghosts.Pandora.Infrastructure.Models.DirectMessage> ?? Enumerable.Empty<Ghosts.Pandora.Infrastructure.Models.DirectMessage>()).ToList();

    bool Mine(Ghosts.Pandora.Infrastructure.Models.DirectMessage m) => string.Equals(m.FromUsername, me, StringComparison.OrdinalIgnoreCase);
    string Day(DateTime utc)
    {
        var date = utc.Date;
        if (date == DateTime.UtcNow.Date) return "Today";
        if (date == DateTime.UtcNow.Date.AddDays(-1)) return "Yesterday";
        return utc.ToString(utc.Year == DateTime.UtcNow.Year ? "MMM d" : "MMM d, yyyy");
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="current-user" content="@me">
    <title>@Present.DisplayName(partner) - Messages - YouTube</title>
    <link rel="stylesheet" href="/themes/youtube/css/feed.css?@System.Guid.NewGuid()">
    <link rel="icon" href="/themes/youtube/images/youtube-icon.svg" type="image/svg+xml">
</head>
<body data-theme="youtube" class="yt-browse-page yt-chat-page">
    @await Html.PartialAsync("~/Views/Themes/youtube/_masthead.cshtml")
    @await Html.PartialAsync("~/Views/Themes/youtube/_guide.cshtml")

    <main class="yt-page-manager">
        <div class="yt-inbox">
            @await Html.PartialAsync("~/Views/Themes/youtube/_inboxlist.cshtml")

            <div class="yt-inbox-main">
                <div class="yt-chat-head">
                    <a class="yt-icon-btn" href="/messages" aria-label="Back"><svg class="yt-icon"><use href="#yt-i-back"/></svg></a>
                    <a href="/u/@partner"><img src="/u/@partner/avatar" alt=""></a>
                    <div>
                        <div class="yt-chat-head-name">@Present.DisplayName(partner)</div>
                        <div class="yt-chat-head-sub">@Present.Handle(partner)</div>
                    </div>
                    <a class="yt-pill" href="/u/@partner">View channel</a>
                </div>

                <div class="yt-chat-scroll">
                    <div class="yt-chat-intro">
                        <img src="/u/@partner/avatar" alt="">
                        <b>@Present.DisplayName(partner)</b>
                        @Present.Handle(partner)
                    </div>
                    @for (var i = 0; i < conversation.Count; i++)
                    {
                        var message = conversation[i];
                        var mine = Mine(message);
                        var nextMessage = i + 1 < conversation.Count ? conversation[i + 1] : null;
                        var lastInGroup = nextMessage == null || Mine(nextMessage) != mine || nextMessage.CreatedUtc - message.CreatedUtc > TimeSpan.FromMinutes(10);
                        if (i == 0 || conversation[i - 1].CreatedUtc.Date != message.CreatedUtc.Date)
                        {
                            <div class="yt-chat-day">@Day(message.CreatedUtc)</div>
                        }
                        <div class="yt-bubble-row @(mine ? "sent" : "received")">
                            @if (!mine)
                            {
                                <img src="/u/@partner/avatar" alt="" style="visibility:@(lastInGroup ? "visible" : "hidden")">
                            }
                            <div class="yt-bubble">@MessageHtml.Render(message.Message)</div>
                        </div>
                        @if (lastInGroup)
                        {
                            <div class="yt-bubble-time">@message.CreatedUtc.ToString("h:mm tt")@(mine && message.ReadUtc != null ? " · Seen" : "")</div>
                        }
                    }
                </div>

                <form class="yt-chat-form" method="post" action="/messages/send">
                    <input type="hidden" name="toUsername" value="@partner">
                    <textarea name="message" rows="1" maxlength="2000" placeholder="Send a message" required></textarea>
                    <button class="yt-icon-btn" type="submit" aria-label="Send"><svg class="yt-icon"><use href="#yt-i-send"/></svg></button>
                </form>
            </div>
        </div>
    </main>

    @await Html.PartialAsync("_Scripts")
    <script src="/themes/youtube/js/youtube.js?@System.Guid.NewGuid()"></script>
</body>
</html>
