@model Ghosts.Pandora.Infrastructure.ViewModels.SearchResultsViewModel
@functions {
    // A stable, plausible subscriber count for a channel (the watch and channel pages use the same formula)
    static int Subscribers(string username)
    {
        var unit = Ghosts.Pandora.Infrastructure.Content.ContentRequest.StableHash($"{username}:subscribers") % 10000 / 10000d;
        return 80 + (int)(unit * unit * unit * 480000);
    }
}
@{
    Layout = null;
    ViewBag.Theme = "youtube";
    ViewData["ytActive"] = string.Empty;
    var query = Model?.Query ?? string.Empty;
    ViewData["ytQuery"] = query;
    var users = Model?.Users ?? Array.Empty<Ghosts.Pandora.Infrastructure.Models.User>();
    var posts = Model?.Posts ?? Array.Empty<Ghosts.Pandora.Infrastructure.Models.Post>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="current-user" content="@ViewBag.Username">
    <title>@(string.IsNullOrWhiteSpace(query) ? "YouTube" : $"{query} - YouTube")</title>
    <link rel="stylesheet" href="/themes/youtube/css/feed.css?@System.Guid.NewGuid()">
    <link rel="icon" href="/themes/youtube/images/youtube-icon.svg" type="image/svg+xml">
</head>
<body data-theme="youtube" class="yt-browse-page">
    @await Html.PartialAsync("~/Views/Themes/youtube/_masthead.cshtml")
    @await Html.PartialAsync("~/Views/Themes/youtube/_guide.cshtml")

    <main class="yt-page-manager">
        <div class="yt-search-results">
            <div class="yt-search-chips">
                <div class="yt-chips">
                    <button class="yt-chip selected" type="button">All</button>
                    <button class="yt-chip" type="button">Shorts</button>
                    <button class="yt-chip" type="button">Videos</button>
                    <button class="yt-chip" type="button">Unwatched</button>
                    <button class="yt-chip" type="button">Watched</button>
                    <button class="yt-chip" type="button">Recently uploaded</button>
                    <button class="yt-chip" type="button">Live</button>
                </div>
                <button class="yt-text-btn" type="button" data-toast="Upload date: Any time · Type: All · Duration: Any">Filters<svg class="yt-icon"><use href="#yt-i-sort"/></svg></button>
            </div>

            @foreach (var user in users.Take(3))
            {
                <div class="yt-channel-result">
                    <a class="yt-channel-result-avatar" href="/u/@user.Username"><img src="/u/@user.Username/avatar" alt=""></a>
                    <div class="yt-channel-result-text">
                        <a href="/u/@user.Username"><h3>@Present.DisplayName(user.Username)</h3></a>
                        <div>@Present.Handle(user.Username) &bull; @SocialPresentation.Compact(Subscribers(user.Username)) subscribers</div>
                        <p>@(string.IsNullOrWhiteSpace(user.Bio) || user.Bio == $"User {user.Username}" ? Present.Headline(user.Username) : user.Bio)</p>
                    </div>
                    @if (!string.Equals(user.Username, ViewBag.Username as string, StringComparison.OrdinalIgnoreCase))
                    {
                        <button class="yt-pill yt-subscribe" type="button" data-username="@user.Username" data-subscribed="false">Subscribe</button>
                    }
                </div>
            }

            @foreach (var post in posts)
            {
                <div class="yt-video-result" data-post-id="@post.Id">
                    <a class="yt-thumb" href="/posts/@post.Id" tabindex="-1" aria-hidden="true">
                        <img src="@Present.PhotoUrl(post)" alt="" loading="lazy">
                        <span class="yt-badge">@Present.Duration(post.Id)</span>
                    </a>
                    <div class="yt-video-result-text">
                        <a href="/posts/@post.Id"><h3>@Present.Title(post)</h3></a>
                        <div class="yt-stats"><span>@SocialPresentation.Compact(Present.Views(post)) views</span><span>@SocialPresentation.LongAgo(post.CreatedUtc)</span></div>
                        <div class="yt-video-result-channel">
                            <a href="/u/@post.Username"><img src="/u/@post.Username/avatar" alt=""></a>
                            <a href="/u/@post.Username" data-username="@post.Username" data-display-name>@Present.DisplayName(post.Username)</a>
                        </div>
                        <p>@MessageHtml.Render(post.Message)</p>
                        <button class="yt-icon-btn yt-card-menu" type="button" aria-label="Action menu"><svg class="yt-icon"><use href="#yt-i-more-vert"/></svg></button>
                    </div>
                </div>
            }

            @if (users.Count == 0 && posts.Count == 0)
            {
                <div class="yt-empty">
                    <svg class="yt-icon"><use href="#yt-i-search"/></svg>
                    <h2>@(string.IsNullOrWhiteSpace(query) ? "Search YouTube" : "No results found")</h2>
                    <p>@(string.IsNullOrWhiteSpace(query) ? "Find videos, channels and more." : "Try different keywords or remove search filters")</p>
                </div>
            }
        </div>
    </main>

    @await Html.PartialAsync("_Scripts")
    <script src="/themes/youtube/js/youtube.js?@System.Guid.NewGuid()"></script>
</body>
</html>
