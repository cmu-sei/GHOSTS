@{
    Layout = null;
    ViewBag.Theme = "instagram";
    ViewData["IgActive"] = "messages";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="current-user" content="@ViewBag.Username">
    <title>Inbox • Direct</title>
    <link rel="stylesheet" href="/themes/instagram/css/feed.css?@System.Guid.NewGuid()">
    <link rel="icon" href="/themes/instagram/images/favicon.svg" type="image/svg+xml">
</head>
<body data-theme="instagram" class="ig ig-direct ig-compact-nav">
@await Html.PartialAsync("~/Views/Themes/instagram/_igsprite.cshtml")
@await Html.PartialAsync("~/Views/Themes/instagram/_ignav.cshtml")

<main class="ig-main">
    <div class="ig-dm">
        @await Html.PartialAsync("~/Views/Themes/instagram/_iginbox.cshtml")
        <section class="ig-dm-main">
            <div class="ig-dm-empty">
                <svg class="ig-i ig-i-96" aria-hidden="true"><use href="#ig-direct-big"/></svg>
                <div class="ig-dm-empty-title">Your messages</div>
                <div class="ig-muted">Send a message to start a chat.</div>
                <button type="button" class="ig-btn ig-btn-blue" data-ig-new-message>Send message</button>
            </div>
        </section>
    </div>
</main>

<script src="/themes/instagram/js/instagram.js?@System.Guid.NewGuid()"></script>
</body>
</html>
