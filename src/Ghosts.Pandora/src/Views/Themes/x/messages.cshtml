@{
    Layout = null;
    ViewBag.Theme = "x";
    ViewData["XNav"] = "messages";
    var me = ViewBag.Username as string ?? "user";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="current-user" content="@me">
    <title>Messages / X</title>
    <link rel="stylesheet" href="/themes/x/css/x.css?@System.Guid.NewGuid()">
    <link rel="icon" href="/themes/x/images/favicon.svg" type="image/svg+xml">
</head>
<body data-theme="x">
    @await Html.PartialAsync("/Views/Themes/x/_xsprite.cshtml")
    <div class="x-app">
        @await Html.PartialAsync("/Views/Themes/x/_xnav.cshtml")
        <main class="x-main" role="main">
            <div class="x-main-inner">
                <div class="x-dm">
                    @await Html.PartialAsync("/Views/Themes/x/_xdmlist.cshtml")
                    <section class="x-dm-pane x-dm-select" aria-label="Conversation">
                        <div class="x-empty">
                            <h2>Select a message</h2>
                            <p>Choose from your existing conversations, start a new one, or just keep swimming.</p>
                            <button type="button" class="x-btn-dark x-btn-big" data-x-newdm>New message</button>
                        </div>
                    </section>
                </div>
            </div>
        </main>
    </div>

    <script src="/themes/x/js/x.js?@System.Guid.NewGuid()"></script>
</body>
</html>
