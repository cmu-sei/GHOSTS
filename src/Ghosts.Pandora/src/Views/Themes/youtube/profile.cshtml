@model Ghosts.Pandora.Infrastructure.Models.User
@functions {
    // A stable, plausible subscriber count for a channel (the watch page uses the same formula)
    static int Subscribers(string username)
    {
        var unit = Ghosts.Pandora.Infrastructure.Content.ContentRequest.StableHash($"{username}:subscribers") % 10000 / 10000d;
        return 80 + (int)(unit * unit * unit * 480000);
    }
}
@{
    Layout = null;
    ViewBag.Theme = "youtube";
    var posts = ViewBag.Posts as List<Ghosts.Pandora.Infrastructure.Models.Post> ?? new List<Ghosts.Pandora.Infrastructure.Models.Post>();
    var username = Model?.Username ?? ViewBag.ProfileUsername as string ?? string.Empty;
    var isSelf = ViewBag.IsSelf as bool? ?? false;
    var isFollowing = ViewBag.IsFollowing as bool? ?? false;
    ViewData["ytActive"] = isSelf ? "yourvideos" : string.Empty;

    var name = Present.DisplayName(username);
    var headline = Present.Headline(username);
    var bio = string.IsNullOrWhiteSpace(Model?.Bio) || Model.Bio == $"User {username}" ? headline : Model.Bio;
    var inWorld = headline.EndsWith(Present.World.OrganizationName, StringComparison.Ordinal);
    var banners = new[] { 1, 2, 3, 4, 7, 8, 9, 10 };
    var banner = $"/img/last-photo{banners[Ghosts.Pandora.Infrastructure.Content.ContentRequest.StableHash($"{username}:banner") % banners.Length]}-large.jpg";
    var latest = posts.OrderByDescending(p => p.CreatedUtc).ToList();
    var popular = posts.OrderByDescending(p => Present.Views(p)).ToList();
    var featured = popular.FirstOrDefault();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="current-user" content="@ViewBag.Username">
    <title>@name - YouTube</title>
    <link rel="stylesheet" href="/themes/youtube/css/feed.css?@System.Guid.NewGuid()">
    <link rel="icon" href="/themes/youtube/images/youtube-icon.svg" type="image/svg+xml">
</head>
<body data-theme="youtube" class="yt-browse-page">
    @await Html.PartialAsync("~/Views/Themes/youtube/_masthead.cshtml")
    @await Html.PartialAsync("~/Views/Themes/youtube/_guide.cshtml")

    <main class="yt-page-manager">
        <div class="yt-channel">
            <div class="yt-channel-banner"><img src="@banner" alt=""></div>

            <div class="yt-channel-header">
                <img class="yt-channel-avatar" src="/u/@username/avatar" alt="">
                <div class="yt-channel-text">
                    <h1 class="yt-channel-name">@name</h1>
                    <div class="yt-channel-meta"><span><b>@Present.Handle(username)</b></span><span>@SocialPresentation.Compact(Subscribers(username)) subscribers</span><span>@posts.Count video@(posts.Count == 1 ? "" : "s")</span></div>
                    <div class="yt-channel-desc"><span>@bio</span><b>...more</b></div>
                    @if (inWorld)
                    {
                        <div class="yt-channel-links"><a class="yt-link" href="https://@Present.World.Domain">@Present.World.Domain</a></div>
                    }
                    <div class="yt-channel-actions">
                        @if (isSelf)
                        {
                            <button class="yt-pill" type="button" data-toast="Channel customization opens in YouTube Studio">Customize channel</button>
                            <button class="yt-pill" type="button" data-open-upload>Manage videos</button>
                        }
                        else
                        {
                            <button class="yt-pill yt-subscribe" type="button" data-username="@username" data-subscribed="@(isFollowing ? "true" : "false")">Subscribe</button>
                        }
                    </div>
                </div>
            </div>

            <nav class="yt-tabs">
                <button class="yt-tab active" type="button" data-tab="home">Home</button>
                <button class="yt-tab" type="button" data-tab="videos">Videos</button>
                <button class="yt-tab" type="button" data-tab="shorts">Shorts</button>
                <button class="yt-tab" type="button" data-tab="playlists">Playlists</button>
                <form class="yt-tab-search" action="/search" method="get">
                    <button class="yt-icon-btn" type="submit" aria-label="Search"><svg class="yt-icon"><use href="#yt-i-search"/></svg></button>
                    <input type="hidden" name="q" value="@name">
                </form>
            </nav>

            <section class="yt-tab-panel" data-panel="home">
                @if (featured == null)
                {
                    <div class="yt-empty">
                        <svg class="yt-icon"><use href="#yt-i-your-videos"/></svg>
                        <h2>This channel doesn't have any content</h2>
                        @if (isSelf)
                        {
                            <p>Upload a video to get started.</p>
                            <p><button class="yt-pill yt-pill-dark" type="button" data-open-upload>Upload video</button></p>
                        }
                    </div>
                }
                else
                {
                    <div class="yt-channel-featured" data-post-id="@featured.Id">
                        <a class="yt-thumb" href="/posts/@featured.Id">
                            <img src="@Present.PhotoUrl(featured)" alt="">
                            <span class="yt-badge">@Present.Duration(featured.Id)</span>
                        </a>
                        <div>
                            <h2><a href="/posts/@featured.Id">@Present.Title(featured)</a></h2>
                            <div class="yt-stats"><span>@SocialPresentation.Compact(Present.Views(featured)) views</span><span>@SocialPresentation.LongAgo(featured.CreatedUtc)</span></div>
                            <p>@MessageHtml.Render(featured.Message)</p>
                        </div>
                    </div>

                    <div class="yt-shelf-head">
                        <h2>Videos</h2>
                        <button class="yt-text-btn" type="button" data-tab-link="videos"><svg class="yt-icon" style="display:inline;vertical-align:-7px;margin-right:4px"><use href="#yt-i-play"/></svg>Play all</button>
                    </div>
                    <div class="yt-shelf-row">
                        @foreach (var post in latest.Take(5))
                        {
                            await Html.RenderPartialAsync("~/Views/Themes/youtube/_postcard.cshtml", post);
                        }
                    </div>

                    @if (popular.Count > 5)
                    {
                        <div class="yt-shelf-head"><h2>Popular videos</h2></div>
                        <div class="yt-shelf-row">
                            @foreach (var post in popular.Take(5))
                            {
                                await Html.RenderPartialAsync("~/Views/Themes/youtube/_postcard.cshtml", post);
                            }
                        </div>
                    }
                }
            </section>

            <section class="yt-tab-panel" data-panel="videos" hidden>
                <div class="yt-channel-sort">
                    <button class="yt-chip selected" type="button" data-sort="latest">Latest</button>
                    <button class="yt-chip" type="button" data-sort="popular">Popular</button>
                    <button class="yt-chip" type="button" data-sort="oldest">Oldest</button>
                </div>
                <div class="yt-rich-grid">
                    @foreach (var post in latest)
                    {
                        await Html.RenderPartialAsync("~/Views/Themes/youtube/_postcard.cshtml", post);
                    }
                </div>
                @if (posts.Count == 0)
                {
                    <div class="yt-tab-empty">This channel has no videos.</div>
                }
            </section>

            <section class="yt-tab-panel" data-panel="shorts" hidden>
                <div class="yt-shorts-grid">
                    @foreach (var post in popular)
                    {
                        <div class="yt-short" data-post-id="@post.Id">
                            <a class="yt-thumb" href="/posts/@post.Id"><img src="@Present.PhotoUrl(post.Id, 5)" alt="" loading="lazy"></a>
                            <div class="yt-details">
                                <div class="yt-meta">
                                    <h3 class="yt-title"><a href="/posts/@post.Id">@Present.Title(post)</a></h3>
                                    <div class="yt-stats"><span>@SocialPresentation.Compact(Present.Views(post) / 3) views</span></div>
                                </div>
                                <button class="yt-icon-btn yt-card-menu" type="button" aria-label="Action menu"><svg class="yt-icon"><use href="#yt-i-more-vert"/></svg></button>
                            </div>
                        </div>
                    }
                </div>
                @if (posts.Count == 0)
                {
                    <div class="yt-tab-empty">This channel has no Shorts.</div>
                }
            </section>

            <section class="yt-tab-panel" data-panel="playlists" hidden>
                <h3 class="yt-section-title">Created playlists</h3>
                @if (featured != null)
                {
                    <div class="yt-rich-grid">
                        @foreach (var (title, list) in new[] { ("Popular uploads", popular), ("Uploads", latest) })
                        {
                            <div class="yt-video-card">
                                <a class="yt-thumb-wrap yt-playlist-thumb" href="/posts/@list[0].Id">
                                    <span class="yt-thumb"><img src="@Present.PhotoUrl(list[0])" alt="" loading="lazy"><span class="yt-badge"><svg class="yt-icon"><use href="#yt-i-playlists"/></svg>@list.Count video@(list.Count == 1 ? "" : "s")</span></span>
                                </a>
                                <div class="yt-details">
                                    <div class="yt-meta">
                                        <h3 class="yt-title"><a href="/posts/@list[0].Id">@title</a></h3>
                                        <a class="yt-playlist-link" href="/posts/@list[0].Id">View full playlist</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="yt-tab-empty">This channel has no playlists.</div>
                }
            </section>
        </div>
    </main>

    @await Html.PartialAsync("_Scripts")
    <script src="/themes/youtube/js/youtube.js?@System.Guid.NewGuid()"></script>
</body>
</html>
