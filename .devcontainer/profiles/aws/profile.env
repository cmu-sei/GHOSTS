AWS_REGION=us-east-1
CLAUDE_CODE_USE_BEDROCK=1
# Force Pi's Bedrock client onto HTTP/1.1 (NodeHttpHandler). The AWS SDK's
# default NodeHttp2Handler holds one long-lived, multiplexed HTTP/2 session.
# An intermediary (Zscaler's TLS interception, a load balancer/NAT idle
# timeout) or AWS itself can reset that idle/mid-stream session, surfacing as
# NGHTTP2_INTERNAL_ERROR and exhausting Pi's retries. HTTP/1.1 has no shared
# session to poison. (Upstream escape hatch, present in the published release.)
AWS_BEDROCK_FORCE_HTTP1=1
# Claude Code's pinned-model env vars are NOT here — they live in this profile's
# claude.json and are merged into ~/.claude/settings.json's env block by
# postcreate.sh, so a model bump reaches Claude Code on the next create like it
# already did for Codex/OpenCode/Pi/LiteLLM. devcontainer.env is generated once
# and gitignored, so anything pinned here would freeze at first setup.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
