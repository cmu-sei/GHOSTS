@using Ghosts.Pandora.Infrastructure.Content
@model Ghosts.Pandora.Infrastructure.ViewModels.SearchResultsViewModel
@inject Ghosts.Pandora.Infrastructure.Services.IUserService Users
@{
    Layout = null;
    ViewBag.Theme = "linkedin";
    ViewData["LiNav"] = "";
    var me = ViewBag.Username as string ?? string.Empty;
    var query = Model?.Query ?? string.Empty;
    var hasQuery = Model?.HasQuery == true;

    // People match on their name and headline too, as on LinkedIn, not only on the username
    var people = new List<Ghosts.Pandora.Infrastructure.Models.User>(Model?.Users ?? Array.Empty<Ghosts.Pandora.Infrastructure.Models.User>());
    if (hasQuery)
    {
        foreach (var user in await Users.GetUsersByThemeAsync("linkedin", 200))
        {
            if (people.Any(p => string.Equals(p.Username, user.Username, StringComparison.OrdinalIgnoreCase)))
                continue;
            if (Present.DisplayName(user.Username).Contains(query, StringComparison.OrdinalIgnoreCase) ||
                Present.Headline(user.Username).Contains(query, StringComparison.OrdinalIgnoreCase))
                people.Add(user);
        }
    }
    people = people.Where(p => !string.Equals(p.Username, me, StringComparison.OrdinalIgnoreCase)).ToList();
    var posts = Model?.Posts ?? Array.Empty<Ghosts.Pandora.Infrastructure.Models.Post>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="current-user" content="@me">
    <title>@(hasQuery ? $"{query} | Search | LinkedIn" : "Search | LinkedIn")</title>
    <link rel="stylesheet" href="/themes/linkedin/css/feed.css?@System.Guid.NewGuid()">
    <link rel="icon" href="/themes/linkedin/images/favicon.svg" type="image/svg+xml">
</head>
<body data-theme="linkedin" class="li-body">
    @await Html.PartialAsync("~/Views/Themes/linkedin/_header.cshtml")

    <div class="li-searchbar">
        <div class="li-searchbar__inner">
            <a href="#li-people" class="li-pill li-pill--sm li-pill--on">People</a>
            <a href="#li-posts" class="li-pill li-pill--sm">Posts</a>
            <span class="li-pill li-pill--sm li-inert">Companies</span>
            <span class="li-pill li-pill--sm li-inert">Jobs</span>
            <span class="li-pill li-pill--sm li-inert">Groups</span>
            <span class="li-searchbar__sep"></span>
            <span class="li-pill li-pill--sm li-inert">All filters</span>
        </div>
    </div>

    <div class="li-page li-page--search">
        <aside class="li-left">
            <div class="li-card li-onpage">
                <h2>On this page</h2>
                <a href="#li-people">People</a>
                <a href="#li-posts">Posts</a>
            </div>
        </aside>

        <main class="li-main">
            @if (!hasQuery)
            {
                <div class="li-card li-empty">
                    <h2>Search LinkedIn</h2>
                    <p>Find people, posts and more by typing in the search box above.</p>
                </div>
            }
            else
            {
                <section class="li-card li-results" id="li-people">
                    <h2>People</h2>
                    @if (people.Count == 0)
                    {
                        <p class="li-results__none">No people found for “@query”.</p>
                    }
                    <ul>
                        @foreach (var user in people.Take(10))
                        {
                            var isWorld = Present.World.People.Any(p => string.Equals(p.Username, user.Username, StringComparison.OrdinalIgnoreCase));
                            var degree = ContentRequest.StableHash($"{me}:{user.Username}:degree") % 100 < (isWorld ? 70u : 35u) ? "2nd" : "3rd+";
                            <li class="li-results__person">
                                <a href="/u/@user.Username"><img src="/u/@user.Username/avatar" alt=""></a>
                                <div class="li-results__info">
                                    <a href="/u/@user.Username" class="li-results__name">@Present.DisplayName(user.Username) <span class="li-post__degree">&bull; @degree</span></a>
                                    <span class="li-results__headline">@Present.Headline(user.Username)</span>
                                    <span class="li-results__location">Greater @Present.World.City Area</span>
                                </div>
                                <form method="post" action="/api/relationships/follow" class="li-follow" data-li-done="Pending">
                                    <input type="hidden" name="username" value="@user.Username">
                                    <button type="submit" class="li-btn li-btn--outline-gray"><span>Connect</span></button>
                                </form>
                            </li>
                        }
                    </ul>
                </section>

                <section class="li-results-posts" id="li-posts">
                    <h2 class="li-results-posts__title">Posts</h2>
                    @if (posts.Count == 0)
                    {
                        <div class="li-card li-results__none">No posts found for “@query”.</div>
                    }
                    <div class="feed">
                        @foreach (var post in posts)
                        {
                            await Html.RenderPartialAsync("_PostCard", post);
                        }
                    </div>
                </section>
            }
        </main>

        <aside class="li-right">
            @await Html.PartialAsync("~/Views/Themes/linkedin/_footer.cshtml")
        </aside>
    </div>

    @await Html.PartialAsync("_Scripts")
    <script src="/themes/linkedin/js/linkedin.js?@System.Guid.NewGuid()"></script>
</body>
</html>
