        "type": "postgres",
        "uid": "ghosts"
      },
      "gridPos": {
        "x": 6,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ghosts"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (d ->> 'itemNumber')::int AS \"Item\", d ->> 'label' AS \"Choice\", d ->> 'by' AS \"By\", (d ->> 'at')::timestamp AS \"At\" FROM executions e, jsonb_array_elements(coalesce(e.runstate -> 'decisions', '[]'::jsonb)) d WHERE e.id = $execution ORDER BY 4"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
