@model Ghosts.Pandora.Infrastructure.ViewModels.SearchResultsViewModel
@{
    Layout = null;
    ViewBag.Theme = "facebook";
    var query = Model?.Query ?? string.Empty;
    var me = ViewBag.Username as string ?? string.Empty;
    var people = (Model?.Users ?? Array.Empty<User>())
        .Where(u => !string.Equals(u.Username, me, StringComparison.OrdinalIgnoreCase))
        .Take(8)
        .ToList();
    var posts = Model?.Posts ?? Array.Empty<Post>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(string.IsNullOrWhiteSpace(query) ? "Search" : query) | Facebook</title>
    <link rel="stylesheet" href="/themes/facebook/css/facebook.css">
    <link rel="icon" href="/themes/facebook/images/favicon.svg" type="image/svg+xml">
</head>
<body data-theme="facebook" class="fb-page-search">
    @await Html.PartialAsync("~/Views/Themes/facebook/_fbheader.cshtml")

    <div class="fb-search-page">
        <aside class="fb-search-filters">
            <h1>Search results</h1>
            @if (!string.IsNullOrWhiteSpace(query))
            {
                <div class="fb-legal" style="padding: 0 8px 4px">for "@query"</div>
            }
            <h2>Filters</h2>
            <a href="/search?q=@Uri.EscapeDataString(query)" class="fb-filter active"><span><svg><use href="#fb-menu"></use></svg></span><span>All</span></a>
            <a href="#" class="fb-filter"><span><svg><use href="#fb-comment"></use></svg></span><span>Posts</span></a>
            <a href="#" class="fb-filter"><span><svg><use href="#fb-groups"></use></svg></span><span>People</span></a>
            <a href="#" class="fb-filter"><span><svg><use href="#fb-image"></use></svg></span><span>Photos</span></a>
            <a href="#" class="fb-filter"><span><svg><use href="#fb-video"></use></svg></span><span>Videos</span></a>
            <a href="#" class="fb-filter"><span><svg><use href="#fb-market"></use></svg></span><span>Marketplace</span></a>
            <a href="#" class="fb-filter"><span><svg><use href="#fb-pin"></use></svg></span><span>Places</span></a>
        </aside>

        <main class="fb-search-main">
            <div class="fb-search-inner">
                <form action="/search" method="get" class="fb-search-inline fb-narrow-only" role="search">
                    <svg><use href="#fb-search"></use></svg>
                    <input type="text" name="q" value="@query" placeholder="Search Facebook" aria-label="Search Facebook" autocomplete="off">
                </form>
                @if (Model?.HasQuery != true)
                {
                    <div class="fb-card fb-search-empty">
                        <strong>Search Facebook</strong>
                        Look for people, posts, photos and more.
                    </div>
                }
                else if (people.Count == 0 && posts.Count == 0)
                {
                    <div class="fb-card fb-search-empty">
                        <strong>We didn't find any results</strong>
                        Make sure everything is spelled correctly or try different keywords.
                    </div>
                }
                else
                {
                    @if (people.Count > 0)
                    {
                        <section class="fb-card">
                            <div class="fb-card-title"><h2>People</h2></div>
                            @foreach (var user in people)
                            {
                                <div class="fb-person">
                                    <a href="/u/@user.Username"><img src="/u/@user.Username/avatar" alt=""></a>
                                    <div class="fb-person-text">
                                        <a href="/u/@user.Username" class="fb-person-name">@Present.DisplayName(user.Username)</a>
                                        <div class="fb-person-meta">@Present.Headline(user.Username)</div>
                                        <div class="fb-person-meta">Lives in @Present.World.City</div>
                                    </div>
                                    <a href="/messages/conversation/@user.Username" class="fb-btn fb-btn-tint">Message</a>
                                </div>
                            }
                        </section>
                    }
                    @if (posts.Count > 0)
                    {
                        <h2>Posts</h2>
                        foreach (var post in posts)
                        {
                            await Html.RenderPartialAsync("_PostCard", post);
                        }
                    }
                }
            </div>
        </main>
    </div>

    @await Html.PartialAsync("_Scripts")
    <script src="/themes/facebook/js/facebook.js"></script>
</body>
</html>
