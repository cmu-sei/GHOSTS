@{
    Layout = null;
    ViewBag.Theme = "x";
    var me = ViewBag.Username as string ?? "user";
    var same = StringComparer.OrdinalIgnoreCase;

    // the left navigation's other destinations have no controller of their own, so they land here
    var path = (Context.Request.Path.Value ?? "/").TrimEnd('/').ToLowerInvariant();
    var section = path switch
    {
        "/notifications" => "notifications",
        "/bookmarks" => "bookmarks",
        "/grok" => "grok",
        "/communities" => "communities",
        "/premium" => "premium",
        _ => "home"
    };
    var titles = new Dictionary<string, string>
    {
        ["home"] = "Home", ["notifications"] = "Notifications", ["bookmarks"] = "Bookmarks",
        ["grok"] = "Grok", ["communities"] = "Communities", ["premium"] = "Premium"
    };
    ViewData["XNav"] = section;
    ViewData["XAside"] = section == "home" ? "home" : "section";

    // notifications: likes and replies other people left on the current user's posts
    var mine = (Model ?? new List<Ghosts.Pandora.Infrastructure.Models.Post>()).Where(p => same.Equals(p.Username, me)).ToList();
    var notes = mine
        .SelectMany(p => (p.Likes ?? new List<Ghosts.Pandora.Infrastructure.Models.Like>())
            .Where(l => !same.Equals(l.Username, me))
            .Select(l => (When: l.CreatedUtc, Who: l.Username, Post: p, Comment: (Ghosts.Pandora.Infrastructure.Models.Comment)null)))
        .Concat(mine.SelectMany(p => (p.Comments ?? new List<Ghosts.Pandora.Infrastructure.Models.Comment>())
            .Where(c => !same.Equals(c.Username, me))
            .Select(c => (When: c.CreatedUtc, Who: c.Username, Post: p, Comment: c))))
        .OrderByDescending(n => n.When)
        .Take(50)
        .ToList();
}
@model List<Ghosts.Pandora.Infrastructure.Models.Post>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="current-user" content="@me">
    <title>@titles[section] / X</title>
    <link rel="stylesheet" href="/themes/x/css/x.css?@System.Guid.NewGuid()">
    <link rel="icon" href="/themes/x/images/favicon.svg" type="image/svg+xml">
</head>
<body data-theme="x">
    @await Html.PartialAsync("/Views/Themes/x/_xsprite.cshtml")
    <div class="x-app">
        @await Html.PartialAsync("/Views/Themes/x/_xnav.cshtml")
        <main class="x-main" role="main">
            <div class="x-main-inner">
                <div class="x-primary">
                    @if (section == "home")
                    {
                        <div class="x-sticky">
                            <div class="x-mobile-top">
                                <a href="/u/@me" class="x-mobile-avatar"><img src="/u/@me/avatar" alt="Profile"></a>
                                <svg class="x-mobile-logo"><use href="#x-logo"/></svg>
                                <span></span>
                            </div>
                            <nav class="x-tabs" role="tablist">
                                <a href="/" class="x-tab active" role="tab" data-x-tab="foryou"><span>For you</span></a>
                                <a href="/" class="x-tab" role="tab" data-x-tab="following"><span>Following</span></a>
                            </nav>
                        </div>

                        @await Html.PartialAsync("/Views/Themes/x/_createpost.cshtml")

                        <div class="feed" id="newsfeed-items-grid">
                            @if (Model != null)
                            {
                                foreach (var post in Model)
                                {
                                    await Html.RenderPartialAsync("/Views/Themes/x/_postcard.cshtml", post);
                                }
                            }
                        </div>
                        <div class="x-empty" id="x-following-empty" hidden>
                            <h2>Welcome to your timeline!</h2>
                            <p>It’s empty now, but it won’t be for long. Start following people and you’ll see their posts show up here.</p>
                        </div>
                    }
                    else
                    {
                        <div class="x-sticky">
                            <div class="x-topbar">
                                <div class="x-topbar-titles">
                                    <h2>@titles[section]</h2>
                                    @if (section == "bookmarks")
                                    {
                                        <span class="x-topbar-sub">@Present.Handle(me)</span>
                                    }
                                </div>
                                @if (section == "notifications")
                                {
                                    <button type="button" class="x-icon-btn x-topbar-end" aria-label="Settings" data-x-menu="dm"><svg><use href="#x-gear"/></svg></button>
                                }
                            </div>
                            @if (section == "notifications")
                            {
                                <nav class="x-tabs" role="tablist">
                                    <a href="#" class="x-tab active" role="tab" data-x-pane="x-pane-all"><span>All</span></a>
                                    <a href="#" class="x-tab" role="tab" data-x-pane="x-pane-verified"><span>Verified</span></a>
                                    <a href="#" class="x-tab" role="tab" data-x-pane="x-pane-mentions"><span>Mentions</span></a>
                                </nav>
                            }
                        </div>

                        @switch (section)
                        {
                            case "notifications":
                                <div class="x-pane" id="x-pane-all">
                                    @foreach (var note in notes)
                                    {
                                        @await Html.PartialAsync("/Views/Themes/x/_xnotification.cshtml", note)
                                    }
                                    @if (notes.Count == 0)
                                    {
                                        <div class="x-pane-empty"><h2>Nothing to see here — yet</h2><p>From likes to reposts and a whole lot more, this is where all the action happens.</p></div>
                                    }
                                </div>
                                <div class="x-pane" id="x-pane-verified" hidden>
                                    <div class="x-pane-empty"><h2>Nothing to see here — yet</h2><p>Likes, mentions, reposts, and a whole lot more — when it comes from a verified account, you’ll find it here.</p></div>
                                </div>
                                <div class="x-pane" id="x-pane-mentions" hidden>
                                    @foreach (var note in notes.Where(n => n.Comment != null))
                                    {
                                        @await Html.PartialAsync("/Views/Themes/x/_xnotification.cshtml", note)
                                    }
                                    @if (!notes.Any(n => n.Comment != null))
                                    {
                                        <div class="x-pane-empty"><h2>Nothing to see here — yet</h2><p>When someone mentions you, you’ll find it here.</p></div>
                                    }
                                </div>
                                break;
                            case "bookmarks":
                                <div class="x-pane-empty"><h2>Save posts for later</h2><p>Bookmark posts to easily find them again in the future.</p></div>
                                break;
                            case "communities":
                                <div class="x-pane-empty"><h2>Discover new Communities</h2><p>Join Communities to see posts from people who share your interests, right in your timeline.</p></div>
                                break;
                            case "premium":
                                <div class="x-pane-empty">
                                    <h2>Upgrade to Premium</h2>
                                    <p>Enjoy an enhanced experience, exclusive creator tools, top-tier verification and security.</p>
                                    <p class="x-pane-cta"><button type="button" class="x-btn-dark x-btn-big" data-x-unavailable>Subscribe</button></p>
                                </div>
                                break;
                            case "grok":
                                <div class="x-grok">
                                    <svg class="x-grok-mark"><use href="#x-grok"/></svg>
                                    <h2>Grok</h2>
                                    <form class="x-grok-ask" data-x-unavailable>
                                        <textarea rows="1" placeholder="Ask anything" aria-label="Ask Grok"></textarea>
                                        <button type="submit" class="x-btn-dark" aria-label="Grok something">Ask</button>
                                    </form>
                                </div>
                                break;
                        }
                    }
                </div>
                @await Html.PartialAsync("/Views/Themes/x/_xaside.cshtml")
            </div>
        </main>
    </div>
    <a href="/#compose" class="x-fab" data-x-compose aria-label="Post"><svg><use href="#x-feather"/></svg></a>

    <script>window.xNames = @Json.Serialize(Present.World.People.DistinctBy(p => p.Username).ToDictionary(p => p.Username, p => p.FullName));</script>
    @await Html.PartialAsync("_Scripts")
    <script src="/themes/x/js/x.js?@System.Guid.NewGuid()"></script>
</body>
</html>
