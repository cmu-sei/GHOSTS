          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT number AS \"#\", time AS \"Time\", assigned AS \"Owner\", description AS \"Description\", status AS \"Status\", completedby AS \"By\", completedat AS \"Completed\" FROM execution_timeline_items WHERE executionid = $execution ORDER BY number"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
