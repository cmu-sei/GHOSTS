{
    "id": "claude-code",
    "version": "0.1.0",
    "name": "Claude Code",
    "description": "Installs the Claude Code CLI via the official installer script",
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ],
    "postCreateCommand": "bash -l .devcontainer/features/claude/postcreate.sh",
    "postStartCommand": "bash -l .devcontainer/features/claude/poststart.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code"
            ],
            "settings": {
                "chat.disableAIFeatures": true
            }
        }
    }
}
