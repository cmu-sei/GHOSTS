@{
    Layout = null;
}
@model List<Ghosts.Pandora.Infrastructure.Models.Post>
@inject Ghosts.Pandora.Infrastructure.Services.IUserService Users
@inject Ghosts.Pandora.Infrastructure.Services.IFollowService Follows
@{
    ViewBag.Theme = "linkedin";
    ViewData["LiNav"] = "home";
    var me = ViewBag.Username as string ?? string.Empty;

    var meUser = string.IsNullOrWhiteSpace(me) ? null : await Users.GetUserByUsernameAsync(me, "linkedin");
    var following = meUser == null
        ? new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        : (await Follows.GetFollowingAsync(meUser.Id, 500)).Select(u => u.Username).ToHashSet(StringComparer.OrdinalIgnoreCase);
    ViewData["LiFollowing"] = following;

    // Names and headlines for posts that arrive live, which the page renders in script
    var people = new Dictionary<string, string[]>(StringComparer.OrdinalIgnoreCase);
    foreach (var person in Present.World.People)
        people[person.Username] = new[] { Present.DisplayName(person.Username), Present.Headline(person.Username) };
    foreach (var user in await Users.GetUsersByThemeAsync("linkedin", 200))
        people.TryAdd(user.Username, new[] { Present.DisplayName(user.Username), Present.Headline(user.Username) });
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="current-user" content="@me">
    <title>Feed | LinkedIn</title>
    <link rel="stylesheet" href="/themes/linkedin/css/feed.css?@System.Guid.NewGuid()">
    <link rel="icon" href="/themes/linkedin/images/favicon.svg" type="image/svg+xml">
</head>
<body data-theme="linkedin" class="li-body">
    @await Html.PartialAsync("~/Views/Themes/linkedin/_header.cshtml")

    <div class="li-page li-page--feed">
        <aside class="li-left">
            @await Html.PartialAsync("~/Views/Themes/linkedin/_identity.cshtml")
        </aside>

        <main class="li-main">
            @await Html.PartialAsync("_CreatePost")

            <div class="li-sort">
                <span class="li-sort__line"></span>
                <button type="button" class="li-sort__btn li-inert">Sort by: <strong>Top</strong> <svg width="16" height="16"><use href="#li-caret"/></svg></button>
            </div>

            <div class="feed" id="newsfeed-items-grid">
                @if (Model != null)
                {
                    foreach (var post in Model)
                    {
                        await Html.RenderPartialAsync("_PostCard", post);
                    }
                }
            </div>
        </main>

        <aside class="li-right">
            @await Html.PartialAsync("~/Views/Themes/linkedin/_rail.cshtml", Model ?? new List<Ghosts.Pandora.Infrastructure.Models.Post>())
        </aside>
    </div>

    <script type="application/json" id="li-people">@Json.Serialize(people)</script>
    @await Html.PartialAsync("_Scripts")
    <script src="/themes/linkedin/js/linkedin.js?@System.Guid.NewGuid()"></script>
</body>
</html>
