@model Ghosts.Pandora.Infrastructure.ViewModels.SearchResultsViewModel
@inject Ghosts.Pandora.Infrastructure.Services.IPostService PostService
@inject Ghosts.Pandora.Infrastructure.Services.IUserService Users
@inject Ghosts.Pandora.Infrastructure.Services.IFollowService Follows
@{
    Layout = null;
    ViewBag.Theme = "x";
    var me = ViewBag.Username as string ?? "user";
    var query = Model?.Query ?? string.Empty;
    var hasQuery = Model?.HasQuery == true;
    var users = Model?.Users ?? Array.Empty<Ghosts.Pandora.Infrastructure.Models.User>();
    var posts = Model?.Posts ?? Array.Empty<Ghosts.Pandora.Infrastructure.Models.Post>();
    var media = posts.Where(p => Present.HasPhoto(p, 25)).ToList();
    ViewData["XNav"] = "explore";
    ViewData["XAside"] = hasQuery ? "search" : "explore";

    var trends = hasQuery ? new List<(string Topic, int Posts)>() : Present.Trending(await PostService.GetLatestPostsByTheme("x", 100), 10).ToList();
    var meUser = await Users.GetUserByUsernameAsync(me, "x");
    ViewData["XFollowing"] = meUser == null
        ? new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        : (await Follows.GetFollowingAsync(meUser.Id, 500)).Select(u => u.Username).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var trendLabels = new[] { "Trending in United States", "Trending in United States", "Trending", $"Trending in {Present.World.City}", "Only on X · Trending" };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="current-user" content="@me">
    <title>@(hasQuery ? $"{query} - Search" : "Explore") / X</title>
    <link rel="stylesheet" href="/themes/x/css/x.css?@System.Guid.NewGuid()">
    <link rel="icon" href="/themes/x/images/favicon.svg" type="image/svg+xml">
</head>
<body data-theme="x">
    @await Html.PartialAsync("/Views/Themes/x/_xsprite.cshtml")
    <div class="x-app">
        @await Html.PartialAsync("/Views/Themes/x/_xnav.cshtml")
        <main class="x-main" role="main">
            <div class="x-main-inner">
                <div class="x-primary">
                    <div class="x-sticky">
                        <div class="x-search-head">
                            @if (hasQuery)
                            {
                                <a href="/search" class="x-back" aria-label="Back"><svg><use href="#x-back"/></svg></a>
                            }
                            <form class="x-search" action="/search" method="get" role="search">
                                <svg><use href="#x-explore"/></svg>
                                <input type="text" name="q" value="@query" placeholder="Search" autocomplete="off" aria-label="Search query">
                            </form>
                            <button type="button" class="x-icon-btn" aria-label="Settings" data-x-menu="dm"><svg><use href="#x-gear"/></svg></button>
                        </div>
                        <nav class="x-profile-tabs" role="tablist">
                            @if (hasQuery)
                            {
                                <a href="#" class="x-tab active" role="tab" data-x-pane="x-pane-top"><span>Top</span></a>
                                <a href="#" class="x-tab" role="tab" data-x-pane="x-pane-latest"><span>Latest</span></a>
                                <a href="#" class="x-tab" role="tab" data-x-pane="x-pane-people"><span>People</span></a>
                                <a href="#" class="x-tab" role="tab" data-x-pane="x-pane-media"><span>Media</span></a>
                                <a href="#" class="x-tab" role="tab" data-x-pane="x-pane-lists"><span>Lists</span></a>
                            }
                            else
                            {
                                <a href="/search" class="x-tab active" role="tab"><span>For You</span></a>
                                <a href="/search" class="x-tab" role="tab"><span>Trending</span></a>
                                <a href="/search" class="x-tab" role="tab"><span>News</span></a>
                                <a href="/search" class="x-tab" role="tab"><span>Sports</span></a>
                                <a href="/search" class="x-tab" role="tab"><span>Entertainment</span></a>
                            }
                        </nav>
                    </div>

                    @if (!hasQuery)
                    {
                        <h2 class="x-section-title">What’s happening</h2>
                        @for (var i = 0; i < trends.Count; i++)
                        {
                            var (topic, count) = trends[i];
                            <div class="x-trend" data-href="/search?q=@Uri.EscapeDataString(topic)">
                                <div class="x-trend-meta">@(i + 1) · @trendLabels[i % trendLabels.Length]</div>
                                <div class="x-trend-topic">@topic</div>
                                <div class="x-trend-meta">@SocialPresentation.Compact(count) posts</div>
                                <button type="button" class="x-icon-btn x-trend-more" aria-label="More" data-x-menu="trend"><svg><use href="#x-dots"/></svg></button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="x-pane" id="x-pane-top">
                            @if (users.Count > 0)
                            {
                                <h2 class="x-section-title">People</h2>
                                @foreach (var user in users.Take(3))
                                {
                                    @await Html.PartialAsync("/Views/Themes/x/_xperson.cshtml", user.Username)
                                }
                                <a href="#" class="x-card-more" onclick="document.querySelector('[data-x-pane=x-pane-people]').click(); return false;">View all</a>
                            }
                            @foreach (var post in posts)
                            {
                                await Html.RenderPartialAsync("/Views/Themes/x/_postcard.cshtml", post);
                            }
                            @if (users.Count == 0 && posts.Count == 0)
                            {
                                <div class="x-pane-empty"><h2>No results for “@query”</h2><p>Try searching for something else, or check your Search settings to see if they’re protecting you from potentially sensitive content.</p></div>
                            }
                        </div>
                        <div class="x-pane" id="x-pane-latest" hidden>
                            @foreach (var post in posts.OrderByDescending(p => p.CreatedUtc))
                            {
                                await Html.RenderPartialAsync("/Views/Themes/x/_postcard.cshtml", post);
                            }
                            @if (posts.Count == 0)
                            {
                                <div class="x-pane-empty"><h2>No results for “@query”</h2><p>Try searching for something else.</p></div>
                            }
                        </div>
                        <div class="x-pane" id="x-pane-people" hidden>
                            @foreach (var user in users)
                            {
                                @await Html.PartialAsync("/Views/Themes/x/_xperson.cshtml", user.Username)
                            }
                            @if (users.Count == 0)
                            {
                                <div class="x-pane-empty"><h2>No results for “@query”</h2><p>Try searching for something else.</p></div>
                            }
                        </div>
                        <div class="x-pane" id="x-pane-media" hidden>
                            @foreach (var post in media)
                            {
                                await Html.RenderPartialAsync("/Views/Themes/x/_postcard.cshtml", post);
                            }
                            @if (media.Count == 0)
                            {
                                <div class="x-pane-empty"><h2>No results for “@query”</h2><p>Try searching for something else.</p></div>
                            }
                        </div>
                        <div class="x-pane" id="x-pane-lists" hidden>
                            <div class="x-pane-empty"><h2>No results for “@query”</h2><p>Try searching for something else.</p></div>
                        </div>
                    }
                </div>
                @await Html.PartialAsync("/Views/Themes/x/_xaside.cshtml")
            </div>
        </main>
    </div>

    <script>window.xNames = @Json.Serialize(Present.World.People.DistinctBy(p => p.Username).ToDictionary(p => p.Username, p => p.FullName));</script>
    @await Html.PartialAsync("_Scripts")
    <script src="/themes/x/js/x.js?@System.Guid.NewGuid()"></script>
</body>
</html>
