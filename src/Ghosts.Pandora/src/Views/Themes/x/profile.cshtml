@model Ghosts.Pandora.Infrastructure.Models.User
@inject Ghosts.Pandora.Infrastructure.Services.IPostService PostService
@{
    Layout = null;
    ViewBag.Theme = "x";
    var me = ViewBag.Username as string ?? "user";
    var posts = ViewBag.Posts as List<Ghosts.Pandora.Infrastructure.Models.Post> ?? new List<Ghosts.Pandora.Infrastructure.Models.Post>();
    var username = Model.Username;
    var handle = Present.Handle(username);
    var name = Present.DisplayName(username);
    var isSelf = ViewBag.IsSelf as bool? ?? false;
    var isFollowing = ViewBag.IsFollowing as bool? ?? false;
    ViewData["XNav"] = isSelf ? "profile" : "";
    ViewData["XAside"] = "profile";
    ViewData["XPerson"] = username;

    // a generated "User name" bio says nothing, so people get their job instead
    var bio = string.IsNullOrWhiteSpace(Model.Bio) || Model.Bio == $"User {username}" ? Present.Headline(username) : Model.Bio;

    // replies and likes come from the theme's recent posts
    var recent = await PostService.GetLatestPostsByTheme("x", 100);
    var replies = recent
        .SelectMany(p => (p.Comments ?? new List<Ghosts.Pandora.Infrastructure.Models.Comment>()).Select(c => (Post: p, Comment: c)))
        .Where(r => string.Equals(r.Comment.Username, username, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(r => r.Comment.CreatedUtc)
        .ToList();
    var liked = recent.Where(p => p.Likes?.Any(l => string.Equals(l.Username, username, StringComparison.OrdinalIgnoreCase)) == true).ToList();
    var media = posts.Where(p => Present.HasPhoto(p, 25)).ToList();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="current-user" content="@me">
    <title>@name (@handle) / X</title>
    <link rel="stylesheet" href="/themes/x/css/x.css?@System.Guid.NewGuid()">
    <link rel="icon" href="/themes/x/images/favicon.svg" type="image/svg+xml">
</head>
<body data-theme="x">
    @await Html.PartialAsync("/Views/Themes/x/_xsprite.cshtml")
    <div class="x-app">
        @await Html.PartialAsync("/Views/Themes/x/_xnav.cshtml")
        <main class="x-main" role="main">
            <div class="x-main-inner">
                <div class="x-primary x-profile">
                    <div class="x-sticky">
                        <div class="x-topbar">
                            <a href="/" class="x-back" aria-label="Back" onclick="if (history.length > 1) { history.back(); return false; }"><svg><use href="#x-back"/></svg></a>
                            <div class="x-topbar-titles">
                                <h2>@name</h2>
                                <span class="x-topbar-sub">@posts.Count.ToString("N0") @(posts.Count == 1 ? "post" : "posts")</span>
                            </div>
                        </div>
                    </div>

                    <div class="x-banner"><img src="@Present.PhotoUrl(Model.Id, 7)" alt=""></div>

                    <div class="x-profile-head">
                        <div class="x-profile-top">
                            <img src="/u/@username/avatar" alt="@name" class="x-profile-avatar">
                            <div class="x-profile-actions">
                                @if (isSelf)
                                {
                                    <button type="button" class="x-btn-outline">Edit profile</button>
                                }
                                else
                                {
                                    <button type="button" class="x-btn-circle" aria-label="More" data-x-menu="profile" data-user="@username"><svg><use href="#x-dots"/></svg></button>
                                    <a href="/messages/conversation/@username" class="x-btn-circle" aria-label="Message"><svg><use href="#x-mail"/></svg></a>
                                    <button type="button" class="x-follow@(isFollowing ? " following" : "")" data-x-follow="@username">@(isFollowing ? "Following" : "Follow")</button>
                                }
                            </div>
                        </div>

                        <h1 class="x-profile-name">@name</h1>
                        <div class="x-profile-handle">@handle</div>
                        <div class="x-profile-bio">@bio</div>
                        <div class="x-profile-meta">
                            <span><svg><use href="#x-location"/></svg>@Present.World.City</span>
                            <span><svg><use href="#x-calendar"/></svg>Joined @Model.CreatedUtc.ToString("MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span>
                        </div>

                        <div data-profile-connections data-username="@username">
                            <div class="x-profile-stats">
                                <button type="button" data-x-connections="following"><b data-following-count>0</b> Following</button>
                                <button type="button" data-x-connections="followers"><b data-followers-count>0</b> Followers</button>
                            </div>
                            <div class="x-connections" id="x-connections-following" hidden>
                                <h3>Following</h3>
                                <div class="connections-scroll" data-following-list></div>
                            </div>
                            <div class="x-connections" id="x-connections-followers" hidden>
                                <h3>Followers</h3>
                                <div class="connections-scroll" data-followers-list></div>
                            </div>
                        </div>
                    </div>

                    <nav class="x-profile-tabs" role="tablist">
                        <a href="#" class="x-tab active" role="tab" data-x-pane="x-pane-posts"><span>Posts</span></a>
                        <a href="#" class="x-tab" role="tab" data-x-pane="x-pane-replies"><span>Replies</span></a>
                        <a href="#" class="x-tab" role="tab" data-x-pane="x-pane-highlights"><span>Highlights</span></a>
                        <a href="#" class="x-tab" role="tab" data-x-pane="x-pane-articles"><span>Articles</span></a>
                        <a href="#" class="x-tab" role="tab" data-x-pane="x-pane-media"><span>Media</span></a>
                        @if (isSelf)
                        {
                            <a href="#" class="x-tab" role="tab" data-x-pane="x-pane-likes"><span>Likes</span></a>
                        }
                    </nav>

                    <div class="x-pane" id="x-pane-posts">
                        @foreach (var post in posts)
                        {
                            await Html.RenderPartialAsync("/Views/Themes/x/_postcard.cshtml", post);
                        }
                        @if (posts.Count == 0)
                        {
                            <div class="x-pane-empty"><h2>@handle hasn’t posted</h2><p>When they do, their posts will show up here.</p></div>
                        }
                    </div>

                    <div class="x-pane" id="x-pane-replies" hidden>
                        @foreach (var (post, comment) in replies)
                        {
                            <article class="tweet" data-username="@username" data-href="/posts/@post.Id">
                                <a href="/u/@username" class="tweet-avatar-link"><img src="/u/@username/avatar" alt="" class="tweet-avatar"></a>
                                <div class="tweet-content">
                                    <div class="tweet-header">
                                        <a href="/u/@username" class="tweet-name">@name</a>
                                        <a href="/u/@username" class="tweet-handle">@handle</a>
                                        <span class="tweet-dot">·</span>
                                        <a href="/posts/@post.Id" class="tweet-time">@SocialPresentation.ShortAgo(comment.CreatedUtc)</a>
                                    </div>
                                    <div class="x-replying">Replying to <a href="/u/@post.Username">@Present.Handle(post.Username)</a></div>
                                    <div class="tweet-text">@MessageHtml.Render(comment.Message)</div>
                                </div>
                            </article>
                        }
                        @if (replies.Count == 0)
                        {
                            <div class="x-pane-empty"><h2>@handle hasn’t replied yet</h2><p>When they do, their replies will show up here.</p></div>
                        }
                    </div>

                    <div class="x-pane" id="x-pane-highlights" hidden>
                        @if (isSelf)
                        {
                            <div class="x-pane-empty"><h2>Highlight on your profile</h2><p>You must be subscribed to Premium to highlight posts on your profile.</p><p class="x-pane-cta"><a href="/premium" class="x-btn-dark x-btn-big">Subscribe to Premium</a></p></div>
                        }
                        else
                        {
                            <div class="x-pane-empty"><h2>@handle hasn’t highlighted any posts</h2><p>When they do, highlighted posts will show up here.</p></div>
                        }
                    </div>

                    <div class="x-pane" id="x-pane-articles" hidden>
                        @if (isSelf)
                        {
                            <div class="x-pane-empty"><h2>Write Articles on X</h2><p>You must be subscribed to Premium+ to write Articles on X.</p><p class="x-pane-cta"><a href="/premium" class="x-btn-dark x-btn-big">Upgrade to Premium+</a></p></div>
                        }
                        else
                        {
                            <div class="x-pane-empty"><h2>@handle hasn’t written any Articles</h2><p>When they do, their Articles will show up here.</p></div>
                        }
                    </div>

                    <div class="x-pane" id="x-pane-media" hidden>
                        @foreach (var post in media)
                        {
                            await Html.RenderPartialAsync("/Views/Themes/x/_postcard.cshtml", post);
                        }
                        @if (media.Count == 0)
                        {
                            <div class="x-pane-empty"><h2>@handle hasn’t posted media</h2><p>Once they do, those posts will show up here.</p></div>
                        }
                    </div>

                    @if (isSelf)
                    {
                        <div class="x-pane" id="x-pane-likes" hidden>
                            @foreach (var post in liked)
                            {
                                await Html.RenderPartialAsync("/Views/Themes/x/_postcard.cshtml", post);
                            }
                            @if (liked.Count == 0)
                            {
                                <div class="x-pane-empty"><h2>You don’t have any likes yet</h2><p>Tap the heart on any post to show it some love. When you do, it’ll show up here.</p></div>
                            }
                        </div>
                    }
                </div>
                @await Html.PartialAsync("/Views/Themes/x/_xaside.cshtml")
            </div>
        </main>
    </div>

    <script>window.xNames = @Json.Serialize(Present.World.People.DistinctBy(p => p.Username).ToDictionary(p => p.Username, p => p.FullName));</script>
    @await Html.PartialAsync("_Scripts")
    <script src="/js/connections.js"></script>
    <script src="/themes/x/js/x.js?@System.Guid.NewGuid()"></script>
</body>
</html>
